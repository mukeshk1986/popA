def save_to_suspected_gaps_with_frequency(
    spark, catalog, ma_reference, gap_schema_curation, df_details, audit_metadata, logger
):
    """
    Save dataframe to suspected_gaps table with proper casting and new CC_ID collapse + frequency logic.
 
    New logic:
      - Count distinct CC_ID per (METHOD_ID, CLAIM_CD_TYPE, CLAIM_CD, CC_CODE, MEMBER_BID)
      - Keep the oldest CLAIM_DT row per group (ties by smallest CLAIM_BID)
      - If count == ref FREQUENCY, set FREQUENCY = ref.FREQUENCY and CONFIDENCE_FACTOR = ref.PERCENT_WEIGHT
        else set FREQUENCY = count and CONFIDENCE_FACTOR = 1
        New Calculation(discussed with Rakesh):
        NET_PERCENT_WEIGHT = 1 - (1 - PERCENT_WEIGHT) * (1 - [next_score]) 
        PERCENT_WEIGHT: from method metadata
        Frequency -> calculated 

    """
 
    # Cast all fields as before
    df_to_write = df_details.select(
        col("METHOD_ID").cast("smallint"),
        col("CLAIM_CD_TYPE").cast("string"),
        col("CLAIM_CD").cast("string"),
        col("CC_ID").cast("int"),
        col("PERCENT_WEIGHT").cast("decimal(7,6)"),

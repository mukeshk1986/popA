def get_cc_code_mapping(spark, catalog: str, ma_reference: str) -> DataFrame:
    """
    Get CC_ID to CC_CODE mapping from reference data.
    
    Maps condition category IDs to their corresponding codes and descriptions
    for specific model versions.
    
    Args:
        catalog: Catalog name
        ma_reference: Reference schema name
    
    Returns:
        DataFrame with CC mappings (SAS_MODEL_YEAR, SAS_MODEL_VERSION, CC_ID, CC_CODE, CC_DESCRIPTION)
        
    Note:
        Filters to model versions: 'MA V2425.86.P1', 'MA V2825.115.T1'
    """
    query = f"""
        SELECT DISTINCT 
            SAS_MODEL_YEAR, 
            SAS_MODEL_VERSION, 
            CC_ID, 
            CC_CODE, 
            CC_DESCRIPTION,
            CHRONIC,
            CASE WHEN CHRONIC = 1 THEN 'Y' ELSE 'N' END AS CHRONIC_HCC
        FROM {catalog}.{ma_reference}.ref_chronic_condition 
        WHERE SAS_MODEL_VERSION IN ('MA V2425.86.P1', 'MA V2825.115.T1','MA E2424.86.T1','MA R0824.84.T1') 
    """
    return spark.sql(query)

def join_method_metadata_with_cc_code( df_method_metadata_inclusion: DataFrame, df_cc_code_mapping: DataFrame ) -> DataFrame:
    """
    Enrich method metadata with CC code details.
    
    Joins method metadata with CC code mapping to add model version,
    year, CC code, and description information.
    
    Args:
        df_method_metadata_inclusion: Method metadata DataFrame
        df_cc_code_mapping: CC code mapping reference
    
    Returns:
        DataFrame with method metadata enriched with CC code details
    """
    return (
        df_method_metadata_inclusion.join(
            df_cc_code_mapping,
            df_method_metadata_inclusion["cc_id"] == df_cc_code_mapping["cc_id"],
            "inner"
        )
        .select(
            df_method_metadata_inclusion["*"],
            df_cc_code_mapping["SAS_MODEL_VERSION"],
            df_cc_code_mapping["SAS_MODEL_YEAR"],
            df_cc_code_mapping["CC_CODE"],
            df_cc_code_mapping["CC_DESCRIPTION"],
            df_cc_code_mapping["CHRONIC_HCC"]
        )
        .distinct()
    )


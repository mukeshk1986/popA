def method4_integration_with_suspected_gaps(spark,catalog,gap_schema_curation,cycle_run, risk_year, no_of_year, mid,
    audit_metadata, logger, save_table):
    """
    Builds suspected_gaps from member_persistent_cc

      1) Filter member_persistent_cc for the cycle_run and suspect statuses
      2) Pick the latest row per (MEMBER_BID, DIAG_CD, SUSPECT_STATUS_TRIM, CYCLE_RUN)
      3) Project into {catalog}.{gap_schema_curation}.suspected_gaps schema & types
      4) Append to the target Delta table (partitioned by SOURCE_LOAD_MONTH)

    
    Mapping highlights / choices:
      - CLAIM_CD_TYPE: constant "DIAGNOSIS"
      - CLAIM_CD: DIAG_CD (padded to VARCHAR(20))
      - SAS_MODEL_VERSION: from source
      - SAS_MODEL_YEAR: 
      - MODEL_VERSION: mapped to RISK_MODEL_VERSION (trimmed to 20)
      - GAP_STATUS: SUSPECT_STATUS (trimmed and restricted to suspect values)
      - HOME_PLAN_ID_CD, FREQUENCY, CONFIDENCE_FACTOR: from source (fallbacks used for nulls)
      - CC_CODE (INT): cast from VARCHAR(50); non-numeric -> NULL
      - CREATE_GAP: Y if "Open Suspect", else N
    """

    try:
        # --- Tables (source -> target) ---
        source_tbl = f"{catalog}.{gap_schema_curation}.member_persistent_cc"
        target_tbl = f"{catalog}.{gap_schema_curation}.suspected_gaps"
        risk_year = int(risk_year)
        no_of_year = int(no_of_year)
        start_year = risk_year - no_of_year + 1
        # 1) Slice source
        src = spark.table(source_tbl)

        pf = (
            src
            .filter((F.col("CYCLE_RUN") == F.lit(cycle_run)) & ((F.col("RISK_YEAR") >= F.lit(start_year)) & (F.col("RISK_YEAR") <= F.lit(risk_year))))
            .withColumn("SUSPECT_STATUS_TRIM", F.trim(F.col("SUSPECT_STATUS")))
            .filter(
                F.col("SUSPECT_STATUS_TRIM").isin(
                    "Open Suspect", "Closed Suspect", "Open Non Suspect"
                )
            )
        )
        # 2) Latest row per key
        w = (
            Window
            # .partitionBy("MEMBER_BID", "DIAG_CD", "SUSPECT_STATUS_TRIM", "CYCLE_RUN")
            .partitionBy("RISK_YEAR","SAS_MODEL_VERSION","MEMBER_BID", "CC_CODE", "SUSPECT_STATUS_TRIM", "CYCLE_RUN")
            .orderBy(
                F.col("CREATED_DATE").desc()
            )
        )
        latest = pf.withColumn("rn", F.row_number().over(w)).filter(F.col("rn") == 1)
        # Source presence guards (for resilience)
        cols = set(latest.columns)
        
        # 3) Project EXACT target schema (order & types per DDL)
        to_insert = latest.select(
            # 1
            F.lit(4).cast("smallint").alias("METHOD_ID"),
            # 2-3            
            F.lit("DIAGNOSIS").alias("CLAIM_CD_TYPE"),            
            F.lit("CLAIM_CODE").alias("CLAIM_CD"),             
            # 4-6            
            F.lit(None).cast("int").alias("CC_ID"),             
            F.col("CONFIDENCE_FACTOR").cast(DecimalType(7, 6)).alias("PERCENT_WEIGHT"),             
            F.col("CC_DESCRIPTION").alias("CC_DESCRIPTION"),             
            # 7-10            
            F.col("RISK_MODEL_YEAR").cast("smallint").alias("SAS_MODEL_YEAR"),  
            # no year present in source             
            F.col("SAS_MODEL_VERSION").alias("SAS_MODEL_VERSION"),             
            F.lit(None).cast("string").alias("CLAIM_CD_MODIFIER"),            
            F.lit(None).cast("string").alias("CLAIM_CD_MODIFIER_TYPE"),             
            # 11-14             
            F.lit("NA").alias("EXCLUSION_1"),            
            F.lit("NA").alias("EXCLUSION_2"),            
            F.lit("NA").alias("EXCLUSION_TYPE_1"),            
            F.lit("NA").alias("EXCLUSION_TYPE_2"),            
            # 15-18            
            F.lit(None).cast("smallint").alias("QUALIFIED_CLAIM"),            
            F.col("RISK_YEAR").cast("int").alias("RISK_YEAR"),            
            F.col("CLAIM_BID").cast("bigint").alias("CLAIM_BID"),            
            F.col("MEMBER_BID").cast("bigint").alias("MEMBER_BID"),             
            # 19-23            
            F.lit(None).cast("string").alias("CLM_PMT_STS_CD"),            
            F.lit(None).cast("string").alias("CLM_TP_CD"),             
            F.lit(None).cast("string").alias("TP_OF_BILL_CD"),            
            F.col("CLAIM_DATE").cast("date").alias("CLAIM_DT"),            
            F.lit(None).cast(DecimalType(10, 2)).alias("ALLWD_AMT"),             
            # 24-29             
            F.col("CYCLE_RUN").alias("SOURCE_LOAD_MONTH"),            
            F.lit(None).cast(DecimalType(3, 0)).alias("CLM_LN_NUM"),            
            F.lit(None).cast("string").alias("CPT_AND_HCPCS_CD"),             
            F.lit(None).cast("string").alias("DIAG_TYPE_CD"),             
            F.lit(None).cast("string").alias("DIAG_NUM"),             
            F.col("DIAG_CD").alias("DIAG_CD"),             
            # 30-34             
            F.lit(None).cast("string").alias("PRINC_PROC_CD"),             
            F.lit(None).cast("string").alias("QUALIFY_CLAIMS"),             
            F.lit(None).cast("string").alias("INVALID_CPT_HCPCS"),            
            F.lit(None).cast("string").alias("CODE"),            
            F.col("PERSISTENT_STATUS_REASON").alias("GAP_REASON"),            
            # 35-39            
            F.col("SUSPECT_STATUS_TRIM").alias("GAP_STATUS"),           
            F.lit(None).cast("string").alias("MATCHED_CODE"),         
            F.lit(None).cast("string").alias("MATCHED_DATE"),           
            F.lit("Inclusion Logic").cast("string").alias("SCENARIO_TYPE"),         
            F.col("RISK_MODEL_VERSION").cast("string").alias("MODEL_VERSION"),    
            # <-- mapped from RISK_MODEL_VERSION           
            # 40-44            
            F.lit(None).cast("string").alias("MATCHING_YN"),           
            F.concat(
                F.lit("CC"),
                F.lpad(F.regexp_extract(F.upper(F.col("CC_CODE")), r"(\d+)$", 1), 3, "0")
            ).alias("CC_CODE"),
            F.when(F.col("SUSPECT_STATUS_TRIM").isin("Open Suspect", "Closed Suspect"), F.lit("N"))
            .when(F.col("SUSPECT_STATUS_TRIM") == "Open Non Suspect", F.lit("Y"))
            .otherwise(F.lit(None).cast("string")).alias("SUPPRESSION1_YN"),
            F.when(F.col("SUSPECT_STATUS_TRIM").isin("Open Suspect", "Closed Suspect", "Open Non Suspect"), F.lit("N"))
            .otherwise(F.lit(None).cast("string")).alias("SUPPRESSION2_YN"),
            F.lit(None).cast("string").alias("SUPPRESSED_BY_PARENT"),
            # 45  
            F.when(F.col("SUSPECT_STATUS_TRIM") == F.lit("Open Suspect"), 
            F.lit("Y")).otherwise(F.lit("N")).cast("string").alias("CREATE_GAP"),           
            # 46-48           
            F.col("HOME_PLAN_ID_CD").cast("string").alias("HOME_PLAN_ID_CD"),       
            F.col("FREQUENCY").cast("int").alias("FREQUENCY"),          
            F.col("CONFIDENCE_FACTOR").cast("decimal(7,6)").alias("CONFIDENCE_FACTOR"),             
            # 49-52           
             # ✅ Use lit() for constants; cast to timestamp if desired
            F.lit(audit_metadata['created_date']).cast("timestamp").alias("CREATED_DATE"),
            F.lit(audit_metadata['created_by']).alias("CREATED_BY"),
            F.lit(audit_metadata['updated_date']).cast("timestamp").alias("UPDATED_DATE"),
            F.lit(audit_metadata['updated_by']).alias("UPDATED_BY"),
        )

        # 4) Append (safer than insertInto for order/type drift)
        if save_table:
            to_insert.write.mode("append").saveAsTable(target_tbl)

        logger.info(
            f"method4_integration_with_suspected_gaps: appended rows to {target_tbl} for cycle_run={cycle_run}"
        )
        
        return to_insert

    except Exception as e:
        logger.error(f"method4_integration_with_suspected_gaps failed for cycle_run={cycle_run}: {e}")
        raise e

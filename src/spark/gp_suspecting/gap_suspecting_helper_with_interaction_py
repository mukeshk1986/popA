        col("RISK_YEAR").cast("int"),
        col("CLAIM_BID").cast("bigint"),
        col("MEMBER_BID").cast("bigint"),
        col("CLM_PMT_STS_CD").cast("string"),
        col("CLM_TP_CD").cast("string"),
        col("TP_OF_BILL_CD").cast("string"),
        col("CLAIM_DT").cast("date"),
        col("ALLWD_AMT").cast("decimal(10,2)"),
        col("SOURCE_LOAD_MONTH").cast("string"),
        # Partition column
        col("CLM_LN_NUM").cast("decimal(3,0)"),
        col("CPT_AND_HCPCS_CD").cast("string"),
        col("DIAG_TYPE_CD").cast("string"),
        col("DIAG_NUM").cast("string"),
        col("DIAG_CD").cast("string"),
        col("PRINC_PROC_CD").cast("string"),
        col("QUALIFY_CLAIMS").cast("string"),
        col("INVALID_CPT_HCPCS").cast("string"),
        col("CODE").cast("string"),
        col("GAP_REASON").cast("string"),
        col("GAP_STATUS").cast("string"),
        col("MATCHED_CODE").cast("string"),
        col("MATCHED_DATE").cast("string"),
        col("SCENARIO_TYPE").cast("string"),
        col("MODEL_VERSION").cast("string"),
        col("MATCHING_YN").cast("string"),
        col("CC_CODE").cast("string"),
        col("CHRONIC_HCC"),
        col("SUPPRESSION1_YN").cast("string"),
        col("SUPPRESSED_BY_PARENT").cast("string"),
        col("SUPPRESSION2_YN").cast("string"),
        col("HOME_PLAN_ID_CD").cast("string"),
        # placeholders; will be computed below
        lit(None).cast("string").alias("FREQUENCY"),
        col("PERCENT_WEIGHT").cast("decimal(7,6)").alias("CONFIDENCE_FACTOR"),
        col("CREATE_GAP").cast("string"),
         # ✅ Use lit() for constants; cast to timestamp if desired
        F.lit(audit_metadata['created_date']).cast("timestamp").alias("CREATED_DATE"),
        F.lit(audit_metadata['created_by']).alias("CREATED_BY"),
        F.lit(audit_metadata['updated_date']).cast("timestamp").alias("UPDATED_DATE"),
        F.lit(audit_metadata['updated_by']).alias("UPDATED_BY"),
    )
 
    # Frequency reference
    df_method_frequence = get_method_metadata_df(spark, catalog, ma_reference, "ref_method_frequency")
    # Expected keys (per your comment): METHOD_ID, CLAIM_CD_TYPE, CLAIM_CD, CC_CODE, FREQUENCY, PERCENT_WEIGHT
    # Add SAS_MODEL_VERSION here too if your reference has it.
 
    # === Fix 1: compute distinct counts via groupBy, not as a window ===
    count_keys = ["METHOD_ID","CLAIM_CD_TYPE","CLAIM_CD","CC_CODE","MEMBER_BID","SAS_MODEL_VERSION","CC_ID"]
    counts_df = (
        df_to_write
        .groupBy(*count_keys)
        .agg(F.countDistinct("CLAIM_BID").alias("group_count"))
    )
 
    # Window to pick oldest CLAIM_DT (ties by CLAIM_BID) per group
    grp_keys_for_oldest = ["METHOD_ID","CLAIM_CD_TYPE","CLAIM_CD","CC_CODE","MEMBER_BID","SAS_MODEL_VERSION","CC_ID"]
    oldest_win = Window.partitionBy(*grp_keys_for_oldest).orderBy(F.col("CLAIM_DT").asc(), F.col("CLAIM_BID").asc())
    # Oldest record per group
    oldest_df = (
        df_to_write
        .withColumn("rn", F.row_number().over(oldest_win))
        .filter(F.col("rn") == 1)
        .drop("rn")
    )
 
    # Join oldest rows with the pre-computed group_count
    df_collapsed = (
        oldest_df
        .join(counts_df, on=count_keys, how="left")
    )
 
    # === Fix 2: join to reference on code-level keys (no MEMBER_BID) ===
    ref_join_keys = ["METHOD_ID","CLAIM_CD_TYPE","CLAIM_CD","CC_ID"]  # add "SAS_MODEL_VERSION" if your ref needs it
    joined = (
        df_collapsed.alias("src")
        .join(
            df_method_frequence.alias("fr"),
            on=ref_join_keys,  # do NOT include MEMBER_BID here
            how="left",
        )
    )
 
    # Compute output FREQUENCY and CONFIDENCE_FACTOR as per rules
    matched = (F.col("src.group_count") == F.col("fr.FREQUENCY")) & F.col("fr.FREQUENCY").isNotNull()
 
    enriched = (
        joined
        .withColumn(
            "FREQUENCY_OUT",
            F.when(matched, F.col("fr.FREQUENCY").cast("string"))
             .otherwise(F.col("src.group_count").cast("string"))
        )
        .withColumn(
            "CONFIDENCE_FACTOR_OUT",
            F.when(matched, F.col("fr.PERCENT_WEIGHT"))
             .otherwise(col("src.PERCENT_WEIGHT").cast("decimal(7,6)"))  #if not matched bring the percent_weight of ref_method_metadata
        )
    )
    # Final projection to match target schema/ordering
    result_df = enriched.select(
        col("src.METHOD_ID").cast("smallint").alias("METHOD_ID"),
        col("src.CLAIM_CD_TYPE").cast("string").alias("CLAIM_CD_TYPE"),
        col("src.CLAIM_CD").cast("string").alias("CLAIM_CD"),
        # Keep CC_ID of the oldest claim row for the group
        col("src.CC_ID").cast("int").alias("CC_ID"),
        col("src.PERCENT_WEIGHT").cast("decimal(7,6)").alias("PERCENT_WEIGHT"),
        col("src.CC_DESCRIPTION").cast("string").alias("CC_DESCRIPTION"),
        col("src.SAS_MODEL_YEAR").cast("smallint").alias("SAS_MODEL_YEAR"),
        col("src.SAS_MODEL_VERSION").cast("string").alias("SAS_MODEL_VERSION"),
        col("src.CLAIM_CD_MODIFIER").cast("string").alias("CLAIM_CD_MODIFIER"),
        col("src.CLAIM_CD_MODIFIER_TYPE").cast("string").alias("CLAIM_CD_MODIFIER_TYPE"),
        col("src.EXCLUSION_1").cast("string").alias("EXCLUSION_1"),
        col("src.EXCLUSION_2").cast("string").alias("EXCLUSION_2"),
        col("src.EXCLUSION_TYPE_1").cast("string").alias("EXCLUSION_TYPE_1"),
        col("src.EXCLUSION_TYPE_2").cast("string").alias("EXCLUSION_TYPE_2"),
        col("src.QUALIFIED_CLAIM").cast("smallint").alias("QUALIFIED_CLAIM"),
        col("src.RISK_YEAR").cast("int").alias("RISK_YEAR"),
        # CLAIM_BID and CLAIM_DT from oldest row
        col("src.CLAIM_BID").cast("bigint").alias("CLAIM_BID"),
        col("src.MEMBER_BID").cast("bigint").alias("MEMBER_BID"),
        col("src.CLM_PMT_STS_CD").cast("string").alias("CLM_PMT_STS_CD"),
        col("src.CLM_TP_CD").cast("string").alias("CLM_TP_CD"),
        col("src.TP_OF_BILL_CD").cast("string").alias("TP_OF_BILL_CD"),
        col("src.CLAIM_DT").cast("date").alias("CLAIM_DT"),
        col("src.ALLWD_AMT").cast("decimal(10,2)").alias("ALLWD_AMT"),
        col("src.SOURCE_LOAD_MONTH").cast("string").alias("SOURCE_LOAD_MONTH"),
        col("src.CLM_LN_NUM").cast("decimal(3,0)").alias("CLM_LN_NUM"),
        col("src.CPT_AND_HCPCS_CD").cast("string").alias("CPT_AND_HCPCS_CD"),
        col("src.DIAG_TYPE_CD").cast("string").alias("DIAG_TYPE_CD"),
        col("src.DIAG_NUM").cast("string").alias("DIAG_NUM"),
        col("src.DIAG_CD").cast("string").alias("DIAG_CD"),
        col("src.PRINC_PROC_CD").cast("string").alias("PRINC_PROC_CD"),
        col("src.QUALIFY_CLAIMS").cast("string").alias("QUALIFY_CLAIMS"),
        col("src.INVALID_CPT_HCPCS").cast("string").alias("INVALID_CPT_HCPCS"),
        col("src.CODE").cast("string").alias("CODE"),
        col("src.GAP_REASON").cast("string").alias("GAP_REASON"),
        col("src.GAP_STATUS").cast("string").alias("GAP_STATUS"),
        col("src.MATCHED_CODE").cast("string").alias("MATCHED_CODE"),
        col("src.MATCHED_DATE").cast("string").alias("MATCHED_DATE"),
        col("src.SCENARIO_TYPE").cast("string").alias("SCENARIO_TYPE"),
        col("src.MODEL_VERSION").cast("string").alias("MODEL_VERSION"),
        col("src.MATCHING_YN").cast("string").alias("MATCHING_YN"),
        col("src.CC_CODE").cast("string").alias("CC_CODE"),
        col("src.CHRONIC_HCC").cast("string").alias("CHRONIC_HCC"),
        col("src.SUPPRESSION1_YN").cast("string").alias("SUPPRESSION1_YN"),
        col("src.SUPPRESSED_BY_PARENT").cast("string").alias("SUPPRESSED_BY_PARENT"),
        col("src.SUPPRESSION2_YN").cast("string").alias("SUPPRESSION2_YN"),
        col("src.HOME_PLAN_ID_CD").cast("string").alias("HOME_PLAN_ID_CD"),
        # New computed fields
        col("FREQUENCY_OUT").alias("FREQUENCY"),
        col("CONFIDENCE_FACTOR_OUT").alias("CONFIDENCE_FACTOR"),
        col("src.CREATE_GAP").cast("string").alias("CREATE_GAP"),
        col("src.CREATED_DATE"),
        col("src.CREATED_BY"),
        col("src.UPDATED_DATE") ,
        col("src.UPDATED_BY")       
    ).distinct()
  
    # Stage and insert
    result_df.createOrReplaceTempView("staging_suspected_gaps")
    logger.info(f"Started inserting into : {catalog}.{gap_schema_curation}.suspected_gaps")
    spark.sql(f"""
        INSERT INTO {catalog}.{gap_schema_curation}.suspected_gaps (
            METHOD_ID, CLAIM_CD_TYPE, CLAIM_CD, CC_ID, PERCENT_WEIGHT, CC_DESCRIPTION,
            SAS_MODEL_YEAR, SAS_MODEL_VERSION, CLAIM_CD_MODIFIER, CLAIM_CD_MODIFIER_TYPE,
            EXCLUSION_1, EXCLUSION_2, EXCLUSION_TYPE_1, EXCLUSION_TYPE_2, QUALIFIED_CLAIM,
            RISK_YEAR, CLAIM_BID, MEMBER_BID, CLM_PMT_STS_CD, CLM_TP_CD, TP_OF_BILL_CD,
            CLAIM_DT, ALLWD_AMT, SOURCE_LOAD_MONTH, CLM_LN_NUM, CPT_AND_HCPCS_CD,
            DIAG_TYPE_CD, DIAG_NUM, DIAG_CD, PRINC_PROC_CD, QUALIFY_CLAIMS,
            INVALID_CPT_HCPCS, CODE, GAP_REASON, GAP_STATUS, MATCHED_CODE, MATCHED_DATE,
            SCENARIO_TYPE, MODEL_VERSION, MATCHING_YN, CC_CODE, SUPPRESSION1_YN,
            SUPPRESSED_BY_PARENT, SUPPRESSION2_YN, CREATE_GAP, HOME_PLAN_ID_CD,
            FREQUENCY, CONFIDENCE_FACTOR, CREATED_DATE, CREATED_BY, UPDATED_DATE, UPDATED_BY
        )
        SELECT
            s.METHOD_ID, s.CLAIM_CD_TYPE, s.CLAIM_CD, s.CC_ID, s.PERCENT_WEIGHT, s.CC_DESCRIPTION,
            s.SAS_MODEL_YEAR, s.SAS_MODEL_VERSION, s.CLAIM_CD_MODIFIER, s.CLAIM_CD_MODIFIER_TYPE,
            s.EXCLUSION_1, s.EXCLUSION_2, s.EXCLUSION_TYPE_1, s.EXCLUSION_TYPE_2, s.QUALIFIED_CLAIM,
            s.RISK_YEAR, s.CLAIM_BID, s.MEMBER_BID, s.CLM_PMT_STS_CD, s.CLM_TP_CD, s.TP_OF_BILL_CD,
            s.CLAIM_DT, s.ALLWD_AMT, s.SOURCE_LOAD_MONTH, s.CLM_LN_NUM, s.CPT_AND_HCPCS_CD,
            s.DIAG_TYPE_CD, s.DIAG_NUM, s.DIAG_CD, s.PRINC_PROC_CD, s.QUALIFY_CLAIMS,
            s.INVALID_CPT_HCPCS, s.CODE, s.GAP_REASON, s.GAP_STATUS, s.MATCHED_CODE, s.MATCHED_DATE,
            s.SCENARIO_TYPE, s.MODEL_VERSION, s.MATCHING_YN, s.CC_CODE, s.SUPPRESSION1_YN,
            s.SUPPRESSED_BY_PARENT, s.SUPPRESSION2_YN, s.CREATE_GAP, s.HOME_PLAN_ID_CD,

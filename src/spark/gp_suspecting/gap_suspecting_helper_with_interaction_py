def add_suppression1_on_draft_gap(df_final_gap, df_ref_hirarchy):
    """
    Adds SUPPRESSION1_YN and SUPPRESSED_BY_PARENT columns to df_final_gap based on parent-child CC_CODE suppression logic.
    For each group (MEMBER_BID, METHOD_ID, RISK_YEAR, HOME_PLAN_ID_CD, MODEL_VERSION):
      - If both parent and child CC_CODE are present, mark SUPPRESSION1_YN='Y' for child, else 'N'.
      - SUPPRESSED_BY_PARENT captures the parent CC_CODE that caused suppression.
    CC_CODE is 'CC' + 3-digit zero-padded number.
    """
    
    # 1. Prepare hierarchy: explode children, pad to 3 digits, prefix 'CC', keep version
    df_hier = (
        df_ref_hirarchy
        .withColumn("parent_cc", F.concat(F.lit("CC"), F.lpad(F.col("parent").cast("string"), 3, "0")))
        .withColumn("child", F.explode(F.split(F.regexp_replace(F.col("child"), r"\s*", ""), ",")))
        .withColumn("child_cc", F.concat(F.lit("CC"), F.lpad(F.col("child").cast("string"), 3, "0")))
        .select(F.col("version").alias("hier_version"), "parent_cc", "child_cc")
        .distinct()
    )

    # 2. Prepare main df: ensure CC_CODE is string and padded
    df_with_padded = df_final_gap.withColumn(
        "CC_CODE_PADDED",
        F.concat(F.lit("CC"), F.lpad(F.regexp_extract(F.col("CC_CODE"), r"(\d+)", 1), 3, "0"))
    )

    # 3. Self-join to find suppressed children
    group_cols = ["MEMBER_BID", "METHOD_ID", "RISK_YEAR", "HOME_PLAN_ID_CD", "MODEL_VERSION"]
    
    # Find children that have their parent present in the same group
    suppressed = (
        df_with_padded.alias("child")
        .join(
            df_with_padded.alias("parent"),
            [F.col(f"child.{c}") == F.col(f"parent.{c}") for c in group_cols],
            "inner"
        )
        .join(
            df_hier,
            (F.col("parent.CC_CODE_PADDED") == F.col("parent_cc")) &
            (F.col("child.CC_CODE_PADDED") == F.col("child_cc")) &
            (F.col("child.MODEL_VERSION") == F.col("hier_version")),
            "inner"
        )
        .select(
            *[F.col(f"child.{c}") for c in group_cols],
            F.col("child.CC_CODE_PADDED"),
            F.lit('Y').alias("SUPPRESSION1_YN"),
            F.col("parent.CC_CODE").alias("SUPPRESSED_BY_PARENT")
        )
        .dropDuplicates(group_cols + ["CC_CODE_PADDED"])
    )

    # 4. Add suppression columns to all rows
    df_all = df_with_padded.withColumn("SUPPRESSION1_YN", F.lit('N')).withColumn("SUPPRESSED_BY_PARENT", F.lit(None).cast("string"))

    # 5. Overwrite with 'Y' where suppressed
    join_conditions = [F.col(f"all.{c}") == F.col(f"sup.{c}") for c in group_cols]
    join_conditions.append(F.col("all.CC_CODE_PADDED") == F.col("sup.CC_CODE_PADDED"))
    join_condition = reduce(and_, join_conditions)
    
    df_out = (
        df_all.alias("all")
        .join(
            suppressed.alias("sup"),
            join_condition,
            "left"
        )
        .select(
            *[F.col(f"all.{c}") for c in df_final_gap.columns],
            F.when(F.col("sup.SUPPRESSION1_YN") == 'Y', 'Y').otherwise(F.lit('N')).alias("SUPPRESSION1_YN"),
            F.when(F.col("sup.SUPPRESSION1_YN") == 'Y', F.col("sup.SUPPRESSED_BY_PARENT")).otherwise(F.lit(None).cast("string")).alias("SUPPRESSED_BY_PARENT")
        )
    )

    # 6. Reorder columns: insert SUPPRESSION1_YN and SUPPRESSED_BY_PARENT after CC_CODE
    cols = df_final_gap.columns
    if 'CC_CODE' in cols:
        idx = cols.index('CC_CODE')
        new_cols = cols[:idx+1] + ['SUPPRESSION1_YN', 'SUPPRESSED_BY_PARENT'] + [c for c in cols[idx+1:] if c not in ['SUPPRESSION1_YN', 'SUPPRESSED_BY_PARENT']]
    else:
        new_cols = cols + ['SUPPRESSION1_YN', 'SUPPRESSED_BY_PARENT']
    
    return df_out.select(*new_cols)

def two_level_suppression_logic_final(
    df_final_gap: DataFrame,
    df_member_cc_with_BID: DataFrame,
    df_ref_hirarchy: DataFrame
) -> DataFrame:
    """
    Adds SUPPRESSION2_YN column to df_final_gap based on external CC hierarchy suppression.
    Uses existing SUPPRESSION1_YN and SUPPRESSED_BY_PARENT columns from df_final_gap.
    
    Suppression2 Logic:
    - For gaps not already suppressed (SUPPRESSION1_YN='N'), checks if their parent/grandparent 
      exists in member's existing CC codes (from risk_member_output)
    - If parent found in member's CCs, marks SUPPRESSION2_YN='Y', otherwise 'N'

    Parameters:
    -----------
    df_final_gap : DataFrame
        DataFrame containing gap data with SUPPRESSION1_YN and SUPPRESSED_BY_PARENT already populated
    df_member_cc_with_BID : DataFrame
        DataFrame containing member CC codes with BID (CC_Code1..CC_Code100)
    df_ref_hirarchy : DataFrame
        DataFrame containing parent-child hierarchy relationships

    Returns:
    --------
    DataFrame
        Original df_final_gap with SUPPRESSION2_YN column added
    """

    # =========================
    # STEP 1: Build hierarchy lookup for parent-child relationships
    # =========================
    hierarchy_lookup = (
        df_ref_hirarchy
        .withColumn("child", F.explode(F.split(F.col("child"), ",")))
        .withColumn("child", F.trim(F.col("child")).cast("int"))
        .withColumn("parent", F.col("parent").cast("int"))
        .select("version", "parent", "child")
        .dropDuplicates()
    )
    
    # =========================
    # STEP 2: Extract numeric CC_CODE for matching with hierarchy
    # =========================
    df_gaps_with_numeric_cc = df_final_gap.withColumn(
        "CC_CODE_NUM",
        F.regexp_extract(F.col("CC_CODE"), r"(\d+)", 1).cast("int")
    )
    
    # =========================
    # STEP 3: Find parent codes for each gap (only for non-suppressed gaps)
    # =========================
    # For gaps where SUPPRESSION1_YN = 'N', find their parent codes from hierarchy
    gaps_with_parents = (
        df_gaps_with_numeric_cc.alias("gap")
        .filter(F.coalesce(F.col("SUPPRESSION1_YN"), F.lit("N")) == "N")
        .join(
            hierarchy_lookup.alias("hier"),
            (F.col("gap.CC_CODE_NUM") == F.col("hier.child")) &
            (F.col("gap.MODEL_VERSION") == F.col("hier.version")),
            "left"
        )
        .select(
            F.col("gap.MEMBER_BID"),
            F.col("gap.MODEL_VERSION"),
            F.col("gap.RISK_YEAR"),
            F.col("gap.CC_CODE"),
            F.col("gap.CC_CODE_NUM"),
            F.col("hier.parent").alias("PARENT_CODE")
        )
        .filter(F.col("PARENT_CODE").isNotNull())
    )
    
    # =========================
    # STEP 4: Build array of member's existing CC codes from CC_Code1..CC_Code100
    # =========================
    df_member_cc_array = (
        df_member_cc_with_BID
        .select(
            "MEMBER_BID",
            "RISK_MODEL_VERSION",
            "RISK_YEAR",
            F.array(*[
                F.regexp_extract(
                    F.upper(F.trim(F.col(f"CC_Code{i}"))),
                    r"^(CC\d+)$",
                    1
                )
                for i in range(1, 101)  # Check all 100 CC_Code columns
            ]).alias("all_cc_codes")
        )
        .withColumn(
            "all_cc_codes",
            F.array_distinct(
                F.filter(
                    F.col("all_cc_codes"),
                    lambda x: (x.isNotNull()) & (x != "")
                )
            )
        )
    )
    
    # =========================
    # STEP 5: Check if parent exists in member's existing CCs
    # =========================
    suppression2_flags = (
        gaps_with_parents.alias("gwp")
        .join(
            df_member_cc_array.alias("mcc"),
            (F.col("gwp.MEMBER_BID") == F.col("mcc.MEMBER_BID")) &
            (F.col("gwp.MODEL_VERSION") == F.col("mcc.RISK_MODEL_VERSION")) &
            (F.col("gwp.RISK_YEAR") == F.col("mcc.RISK_YEAR")),
            "left"
        )
        .withColumn(
            "PARENT_CODE_STR",
            F.concat(F.lit("CC"), F.lpad(F.col("gwp.PARENT_CODE").cast("string"), 3, "0"))
        )
        .withColumn(
            "PARENT_FOUND",
            F.array_contains(F.col("mcc.all_cc_codes"), F.col("PARENT_CODE_STR"))
        )
        .withColumn(
            "SUPPRESSION2_YN",
            F.when(F.col("PARENT_FOUND") == True, "Y").otherwise("N")
        )
        .select(
            F.col("gwp.MEMBER_BID"),
            F.col("gwp.MODEL_VERSION"),
            F.col("gwp.RISK_YEAR"),
            F.col("gwp.CC_CODE"),
            F.col("SUPPRESSION2_YN")
        )
        # Aggregate to ensure one row per gap - if ANY parent found, mark as 'Y'
        .groupBy("MEMBER_BID", "MODEL_VERSION", "RISK_YEAR", "CC_CODE")
        .agg(
            F.max(F.when(F.col("SUPPRESSION2_YN") == "Y", "Y").otherwise("N")).alias("SUPPRESSION2_YN")
        )
    )
    
    # =========================
    # STEP 6: Join SUPPRESSION2_YN back to original df_final_gap
    # =========================
    # Get columns from df_final_gap excluding SUPPRESSION2_YN if it already exists
    gap_columns = [c for c in df_final_gap.columns if c != 'SUPPRESSION2_YN']
    
    df_result = (
        df_final_gap.alias("gap")
        .join(
            suppression2_flags.alias("s2"),
            (F.col("gap.MEMBER_BID") == F.col("s2.MEMBER_BID")) &
            (F.col("gap.MODEL_VERSION") == F.col("s2.MODEL_VERSION")) &
            (F.col("gap.RISK_YEAR") == F.col("s2.RISK_YEAR")) &
            (F.col("gap.CC_CODE") == F.col("s2.CC_CODE")),
            "left"
        )
        .select(
            *[F.col(f"gap.{c}") for c in gap_columns],
            F.coalesce(F.col("s2.SUPPRESSION2_YN"), F.lit("N")).alias("SUPPRESSION2_YN")
        )
    )
    
    # Reorder columns: insert SUPPRESSION2_YN after SUPPRESSED_BY_PARENT
    if 'SUPPRESSED_BY_PARENT' in gap_columns:
        idx = gap_columns.index('SUPPRESSED_BY_PARENT')
        new_cols = gap_columns[:idx+1] + ['SUPPRESSION2_YN'] + [c for c in gap_columns[idx+1:]]
    else:
        new_cols = gap_columns + ['SUPPRESSION2_YN']
    
    df_result = df_result.select(*new_cols)
    
    return df_result


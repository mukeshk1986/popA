def get_scenario1_gap_claims_optimized( df_method_exclusions: DataFrame,df_final_medical_claims_all: DataFrame,    df_ref_method_metadata_codegroups: DataFrame ) -> DataFrame:
    """
    Optimized Scenario 1 gap identification with modifier and exclusion logic.
    
    Performance optimizations:
    - Early filtering to reduce data volume
    - Broadcast joins for small reference tables
    - Strategic caching to avoid recomputation
    - Array operations to replace expensive self-joins
    - Single LEFT join for exclusion checking
    """
    
    # OPTIMIZATION 1: Filter and broadcast metadata (small table)
    df_scenario1_metadata = broadcast(
        df_method_exclusions.filter(
            (col("PROGRAM") == "CMS") & 
            (col("METHOD_ID").isin(10)) &
            (col("EXCLUSION_TYPE_1") != "NA") & 
            (col("CLAIM_CD_MODIFIER_TYPE") != "NA")
        )
    )
    # OPTIMIZATION 2: Early filtering - reduce claims to last 2 years with valid CPT codes
    df_claims_filtered = df_final_medical_claims_all.filter(
        # (col("CLAIM_DT") >= add_months(current_date(), -24)) &
        (col("CPT_AND_HCPCS_CD").isNotNull())
    )

    # S1: Find claims matching CPT-HCPCS codes (use filtered claims)
    df_s1_claims = df_claims_filtered.join(
        df_scenario1_metadata,
        (df_scenario1_metadata["CLAIM_CD_TYPE"] == "CPT-HCPCS") & 
        (df_scenario1_metadata["CLAIM_CD"] == df_claims_filtered["CPT_AND_HCPCS_CD"]),
        "inner"
    ).select(
        df_claims_filtered["*"],
        df_scenario1_metadata["METHOD_ID"],
        df_scenario1_metadata["CLAIM_CD_TYPE"],
        df_scenario1_metadata["CLAIM_CD"],
        df_scenario1_metadata["CC_ID"],
        df_scenario1_metadata["CLAIM_CD_MODIFIER_TYPE"],
        df_scenario1_metadata["CLAIM_CD_MODIFIER"],
        df_scenario1_metadata["EXCLUSION_TYPE_1"],
        df_scenario1_metadata["EXCLUSION_1"],
        df_scenario1_metadata["EXCLUSION_TYPE_2"],
        df_scenario1_metadata["EXCLUSION_2"],
        df_scenario1_metadata["PERCENT_WEIGHT"],
        df_scenario1_metadata["QUALIFIED_CLAIM"]
    ).cache()  # OPTIMIZATION 3: Cache S1 (reused in S2 and final result)

    # OPTIMIZATION 4: Get relevant members only for downstream filtering
    relevant_members = broadcast(
        df_s1_claims.select("MEMBER_BID").distinct()
    )
    
    # OPTIMIZATION 5: Filter claims to relevant members only
    df_claims_relevant = df_claims_filtered.join(
        relevant_members, "MEMBER_BID", "inner"
    )

    # S2: Optimized modifier check using array operations instead of self-join
    df_s1_claims_distinct = df_s1_claims.select(
        'CPT_AND_HCPCS_CD', 'CLAIM_CD', 
        'CLAIM_CD_MODIFIER_TYPE', 'CLAIM_CD_MODIFIER'
    ).distinct()

    # OPTIMIZATION 6: Broadcast modifier code expansion (small table)
    df_modifier_codes = broadcast(
        df_ref_method_metadata_codegroups.join(
            df_s1_claims_distinct,
            (df_ref_method_metadata_codegroups["CLAIM_CD_TYPE"] == df_s1_claims_distinct["CLAIM_CD_MODIFIER_TYPE"]) &
            (df_ref_method_metadata_codegroups["CLAIM_CD"] == df_s1_claims_distinct["CLAIM_CD_MODIFIER"]),
            "inner"
        ).select(
            df_ref_method_metadata_codegroups["CODE"],
            df_s1_claims_distinct['CPT_AND_HCPCS_CD'], 
            df_s1_claims_distinct['CLAIM_CD'], 
            df_s1_claims_distinct['CLAIM_CD_MODIFIER_TYPE'], 
            df_s1_claims_distinct['CLAIM_CD_MODIFIER']
        )
    )
    
    # OPTIMIZATION 7: Aggregate procedures at claim level (replaces expensive self-join)
    df_claim_procedures = df_claims_relevant.groupBy(
        "CLAIM_BID", "CLM_TP_CD", "MEMBER_BID"
    ).agg(
        collect_set("CPT_AND_HCPCS_CD").alias("ALL_PROCEDURES")
    )
    
    # OPTIMIZATION 8: Group modifier codes by requirement for array intersection
    df_modifier_sets = df_modifier_codes.groupBy(
        'CPT_AND_HCPCS_CD', 'CLAIM_CD', 
        'CLAIM_CD_MODIFIER_TYPE', 'CLAIM_CD_MODIFIER'
    ).agg(
        collect_set("CODE").alias("REQUIRED_MODIFIERS")
    )

    # OPTIMIZATION 9: Use array_intersect instead of join (in-memory operation)
    df_s2_claims = df_s1_claims.alias("s1").join(
        df_claim_procedures,
        ["CLAIM_BID", "CLM_TP_CD", "MEMBER_BID"],
        "inner"
    ).join(
        broadcast(df_modifier_sets),
        ['CPT_AND_HCPCS_CD', 'CLAIM_CD', 'CLAIM_CD_MODIFIER_TYPE', 'CLAIM_CD_MODIFIER'],
        "inner"
    ).filter(
        # Check if ANY modifier from the required set exists in the claim
        size(array_intersect(col("ALL_PROCEDURES"), col("REQUIRED_MODIFIERS"))) > 0
    ).withColumn(
        # Get the first matched modifier code
        "CODE", array_intersect(col("ALL_PROCEDURES"), col("REQUIRED_MODIFIERS"))[0]
    ).select(
        col("CODE"),
        col("s1.CLAIM_BID"),
        col("s1.MEMBER_BID"),
        col("s1.CLM_PMT_STS_CD"),
        col("s1.CLM_TP_CD"),
        col("s1.TP_OF_BILL_CD"),
        col("s1.CLAIM_DT"),
        col("s1.ALLWD_AMT"),
        col("s1.SOURCE_LOAD_MONTH"),
        col("s1.CLM_LN_NUM"),
        col("s1.CPT_AND_HCPCS_CD"),
        col("s1.DIAG_TYPE_CD"),
        col("s1.DIAG_NUM"),
        col("s1.DIAG_CD"),
        col("s1.PRINC_PROC_CD"),
        col("s1.QUALIFY_CLAIMS"),
        col("s1.INVALID_CPT_HCPCS"),
        col("s1.METHOD_ID"),
        col("s1.CLAIM_CD_TYPE"),
        col("s1.CLAIM_CD"),
        col("s1.CC_ID"),
        col("s1.CLAIM_CD_MODIFIER_TYPE"),
        col("s1.CLAIM_CD_MODIFIER"),
        col("s1.EXCLUSION_TYPE_1"),
        col("s1.EXCLUSION_1"),
        col("s1.EXCLUSION_TYPE_2"),
        year(col("s1.CLAIM_DT")).alias("RISK_YEAR"),
        col("s1.EXCLUSION_2"),
        col("s1.PERCENT_WEIGHT"),
        col("s1.QUALIFIED_CLAIM"),
        col("s1.HOME_PLAN_ID_CD"),
        lit("Exclusion logic").alias("SCENARIO_TYPE")
    ).drop("ALL_PROCEDURES", "REQUIRED_MODIFIERS") \
     .distinct() \
     .cache()  # OPTIMIZATION 10: Cache S2 (reused in S3)

    # S3: Optimized exclusion check with pre-filtered history
    # OPTIMIZATION 11: Broadcast exclusion code expansion (small table)
    df_exclusion_codes = broadcast(
        df_ref_method_metadata_codegroups.join(
            df_s2_claims.select("EXCLUSION_TYPE_1", "EXCLUSION_1", "EXCLUSION_TYPE_2", "EXCLUSION_2").distinct(),
            ((df_ref_method_metadata_codegroups["CLAIM_CD_TYPE"] == col("EXCLUSION_TYPE_1")) &
             (df_ref_method_metadata_codegroups["CLAIM_CD"] == col("EXCLUSION_1"))) |
            ((df_ref_method_metadata_codegroups["CLAIM_CD_TYPE"] == col("EXCLUSION_TYPE_2")) &
             (df_ref_method_metadata_codegroups["CLAIM_CD"] == col("EXCLUSION_2"))),
            "inner"
        ).select("CODE", "EXCLUSION_TYPE_1", "EXCLUSION_1", "EXCLUSION_TYPE_2", "EXCLUSION_2").distinct()
    )
    
    # OPTIMIZATION 12: Pre-filter exclusion history (only exclusion codes, only relevant members)
    df_exclusion_history = df_claims_relevant.join(
        df_exclusion_codes.select("CODE").distinct(),
        col("DIAG_CD") == col("CODE"),
        "inner"
    ).select(
        col("MEMBER_BID").alias("HIST_MEMBER_BID"),
        col("CLAIM_DT").alias("HIST_CLAIM_DT"),
        col("DIAG_CD").alias("HIST_DIAG_CD")
    ).distinct()

    # OPTIMIZATION 13: Single LEFT join instead of inner join + separate left join
    # This keeps all S2 records and marks those with exclusions
    df_s2_with_lookback = df_s2_claims.withColumn(
        "LOOKBACK_START", date_sub(col("CLAIM_DT"), 180)
    )
    
    df_final_scenario1 = df_s2_with_lookback.join(
        df_exclusion_history,
        (df_s2_with_lookback["MEMBER_BID"] == col("HIST_MEMBER_BID")) &
        (col("HIST_CLAIM_DT") >= col("LOOKBACK_START")) &
        (col("HIST_CLAIM_DT") <= df_s2_with_lookback["CLAIM_DT"]),
        "left"  # LEFT join keeps all S2 records
    ).select(
        df_s2_with_lookback["*"],
        col("HIST_DIAG_CD").alias("MATCHED_CODE"),
        col("HIST_CLAIM_DT").alias("MATCHED_DATE"),
        # Set GAP_STATUS and GAP_REASON in single pass
        when(col("HIST_DIAG_CD").isNotNull(), lit("Found Exclusion in 180 days with modifier"))
            .otherwise(lit("No Exclusion in 180 days")).alias("GAP_REASON"),
        when(col("HIST_DIAG_CD").isNotNull(), lit("DO NOT Create Gap"))
            .otherwise(lit("Create Gap")).alias("GAP_STATUS")
    ).drop("LOOKBACK_START", "HIST_MEMBER_BID") \
     .distinct()
    
    # OPTIMIZATION 14: Clean up cached DataFrames to free memory
    df_s1_claims.unpersist()
    df_s2_claims.unpersist()
    
    return df_final_scenario1

#lastest_Scenario2 with matched details and without Claim Code Modifier, Complete S1-S2 Gap Logic
def process_scenario2(df_method_exclusions: DataFrame, df_final_medical_claims_all: DataFrame,     df_ref_method_metadata_codegroups: DataFrame) -> DataFrame:
    """
    Process Scenario 2 exclusion logic for gaps WITHOUT claim code modifiers.
    
    Implements S1-S2 gap logic for procedures that do not require specific modifiers.
    Identifies potential gaps and checks for exclusion diagnoses in the last 180 days.
    
    Args:
        df_ref_method_metadata: Method metadata reference data
        df_final_medical_claims_all: Combined facility and professional claims
        df_ref_method_metadata_codegroups: Code group expansions (ICD groups, procedure groups)
    
    Returns:
        DataFrame with Scenario 2 gaps including:
        - GAP_STATUS: "Create Gap" or "DO NOT Create Gap"
        - GAP_REASON: "Found Exclusion in 180 days" or "No Exclusion in 180 days"
        - MATCHED_CODE: Exclusion diagnosis code if found
        - MATCHED_DATE: Date of exclusion diagnosis if found
        
    Gap Logic (S1-S2):
        S1: Match CPT-HCPCS codes from claims to method metadata where:
            - CLAIM_CD_MODIFIER_TYPE = 'NA' (no modifier required)
            - EXCLUSION_TYPE_1 != 'NA' (has exclusion rules)
            
        S2: Check for exclusion diagnoses in last 180 days:
            - Expand exclusion codes using code groups
            - Search historical claims for exclusion diagnoses
            - Flag gaps with exclusions as "DO NOT Create Gap"
            
    Note:
        Complementary to Scenario 1 which handles cases WITH modifiers.
        Used for Methods 1, 2, and 10.
    """
    # Step 1: Get method metadata with CLAIM_CD_MODIFIER = 'NA'
    df_scenario2_metadata = df_method_exclusions.filter(
        (col("PROGRAM") == "CMS") & 
        (col("METHOD_ID").isin(10)) &
        (col("EXCLUSION_TYPE_1") != "NA") & 
        (col("CLAIM_CD_MODIFIER_TYPE") == "NA")
    )

    # S1: Find claims matching CPT-HCPCS codes
    df_s1_claims_scenario2 = df_final_medical_claims_all.alias("claims").join(
        df_scenario2_metadata.alias("meta"),
        (col("meta.CLAIM_CD_TYPE") == "CPT-HCPCS") & 
        (col("meta.CLAIM_CD") == col("claims.CPT_AND_HCPCS_CD")),
        "inner"
    ).select(
        col("claims.*"),
        year(col("claims.CLAIM_DT")).alias("RISK_YEAR"),
        col("meta.METHOD_ID"),
        col("meta.CC_ID"),
        col("meta.CLAIM_CD_TYPE"),
        col("meta.CLAIM_CD"),
        col("meta.CLAIM_CD_MODIFIER_TYPE"),
        col("meta.CLAIM_CD_MODIFIER"),
        col("meta.PERCENT_WEIGHT"),
        col("meta.QUALIFIED_CLAIM"),
        col("meta.EXCLUSION_TYPE_1"),
        col("meta.EXCLUSION_1"),
        col("meta.EXCLUSION_TYPE_2"),
        col("meta.EXCLUSION_2"),
        lit("Exclusion logic").alias("SCENARIO_TYPE")
    ).distinct()

    # S2: Get exclusion Diagnosis codes from method_metadata_group
    df_exclusion_codes_scenario2 = df_ref_method_metadata_codegroups.alias("codegroups").join(
        df_s1_claims_scenario2.select(
            "MEMBER_BID", "EXCLUSION_TYPE_1", "EXCLUSION_1", "EXCLUSION_TYPE_2", "EXCLUSION_2"
        ).distinct().alias("excl"),
        (((col("codegroups.CLAIM_CD_TYPE") == col("excl.EXCLUSION_TYPE_1")) &
         (col("codegroups.CLAIM_CD") == col("excl.EXCLUSION_1"))) |
        ((col("codegroups.CLAIM_CD_TYPE") == col("excl.EXCLUSION_TYPE_2")) &
         (col("codegroups.CLAIM_CD") == col("excl.EXCLUSION_2")))),
        "inner"
    ).select(
        col("excl.MEMBER_BID"), 
        col("codegroups.CODE"), 
        col("excl.EXCLUSION_TYPE_1"), 
        col("excl.EXCLUSION_1"), 
        col("excl.EXCLUSION_TYPE_2"), 
        col("excl.EXCLUSION_2")
    ).distinct()
    # S3: Find exclusion diagnosis in last 180 days
    df_s2_exclusions_scenario2 = df_s1_claims_scenario2.alias("s1").join(
        df_final_medical_claims_all.alias("hist").select(
            col("hist.MEMBER_BID").alias("HIST_MEMBER_BID"),
            col("hist.CLAIM_DT").alias("HIST_CLAIM_DT"),
            col("hist.DIAG_CD").alias("HIST_DIAG_CD")
        ),
        (col("s1.MEMBER_BID") == col("HIST_MEMBER_BID")) &
        (datediff(col("s1.CLAIM_DT"), col("HIST_CLAIM_DT")) >= 0) &
        (datediff(col("s1.CLAIM_DT"), col("HIST_CLAIM_DT")) <= 180),
        "inner"
    ).join(
        df_exclusion_codes_scenario2.alias("excl_codes"),
        (col("HIST_DIAG_CD") == col("excl_codes.CODE")) &
        (col("HIST_MEMBER_BID") == col("excl_codes.MEMBER_BID")),
        "inner"
    ).select(
        col("s1.*"),
        col("excl_codes.CODE"),
        col("HIST_DIAG_CD").alias("MATCHED_CODE"),
        col("HIST_CLAIM_DT").alias("MATCHED_DATE")
    ).distinct()

    # Mark records based on exclusion presence
    df_s2_with_flag_scenario2 = df_s2_exclusions_scenario2.select(
        "CLAIM_BID", "MEMBER_BID", "CLM_TP_CD", "CLAIM_DT", "CPT_AND_HCPCS_CD", "CODE",
        "METHOD_ID", "CC_ID", "MATCHED_CODE", "MATCHED_DATE"
    ).distinct().withColumn("EXCLUSION_FLAG", lit(1))

    # Left join to mark which records had exclusions
    df_final_scenario2 = df_s1_claims_scenario2.alias("s1_all").join(
        df_s2_with_flag_scenario2.alias("s2_flagged"),
        (col("s1_all.CLAIM_BID") == col("s2_flagged.CLAIM_BID")) &
        (col("s1_all.MEMBER_BID") == col("s2_flagged.MEMBER_BID")) &
        (col("s1_all.CLM_TP_CD") == col("s2_flagged.CLM_TP_CD")) &
        (col("s1_all.CLAIM_DT") == col("s2_flagged.CLAIM_DT")) &
        (col("s1_all.CPT_AND_HCPCS_CD") == col("s2_flagged.CPT_AND_HCPCS_CD")) &
        (col("s1_all.METHOD_ID") == col("s2_flagged.METHOD_ID")) &
        (col("s1_all.CC_ID") == col("s2_flagged.CC_ID")),
        "left"
    ).select(
        col("s1_all.*"),
        col("s2_flagged.CODE"),
        col("s2_flagged.MATCHED_CODE"),
        col("s2_flagged.MATCHED_DATE"),
        col("s2_flagged.EXCLUSION_FLAG"),
        when(col("s2_flagged.EXCLUSION_FLAG") == 1, lit("Found Exclusion in 180 days without modifier"))
            .otherwise(lit("No Exclusion in 180 days")).alias("GAP_REASON"),
        when(col("s2_flagged.EXCLUSION_FLAG") == 1, lit("DO NOT Create Gap"))
            .otherwise(lit("Create Gap")).alias("GAP_STATUS")
    )


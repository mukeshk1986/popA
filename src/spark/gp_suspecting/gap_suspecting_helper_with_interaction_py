def insert_risk_member_hcc_from_gaps(
    spark,
    catalog: str,
    curated_schema: str,
    df_suspected_gaps_all: DataFrame,
    load_risk_member_and_scores_df: dict,
    risk_model_year: int,
    no_of_year: int,
    method_id,  # can be int OR list[int]; if DF has METHOD_ID, we’ll filter by these
    audit_metadata: dict,
    threshold_percent: float
) -> DataFrame:
    """
    Inserts into curated risk_member_hcc by:
      Step 1: Computing METHOD_CONFIDENCE_FACTOR = MAX(CONFIDENCE_FACTOR) at method level per key
      Step 2: Applying threshold to METHOD_CONFIDENCE_FACTOR and including all requested methods
      Step 3: Computing COMBINED_CONFIDENCE_FACTOR across methods and persisting both new columns (DECIMAL(5,4)).
    """

    # ---------------------------
    # Normalize inputs & guards
    # ---------------------------
    risk_model_year = int(risk_model_year)

    # Support both int and list-like method_id inputs
    if isinstance(method_id, (list, tuple, set)):
        method_ids = [int(m) for m in method_id]
    else:
        method_ids = [int(method_id)]
    # Ensure CHRONIC_HCC exists (may not exist for Method 4 data)
    if "CHRONIC_HCC" not in df_suspected_gaps_all.columns:
        df_suspected_gaps_all = df_suspected_gaps_all.withColumn("CHRONIC_HCC", F.lit(None).cast("string"))
    
    # Default CHRONIC_HCC to 'Y' for Method 4 if null (persistent HCCs are chronic by definition)
    df_suspected_gaps_all = df_suspected_gaps_all.withColumn(
        "CHRONIC_HCC",
        F.when((F.col("METHOD_ID") == 4) & F.col("CHRONIC_HCC").isNull(), F.lit("Y"))
         .otherwise(F.col("CHRONIC_HCC"))
    )
    # ----------------------------------------------------------------------
    # Step 1: Compute METHOD_CONFIDENCE_FACTOR (MAX per group at method-level)
    # ----------------------------------------------------------------------
    logging.info(f"Started Compute METHOD_CONFIDENCE_FACTOR--->")
    # If DF contains METHOD_ID, we can filter to include just the requested methods.
    df = df_suspected_gaps_all

    # has_method_id_col = "METHOD_ID" in df.columns

    # if has_method_id_col:
    #     df = df.filter(F.col("METHOD_ID").isin(method_ids))

    # Build the grouping keys. If METHOD_ID column exists, include it so the
    # method-level confidence is truly per method.
    group_keys = ["RISK_YEAR", "MODEL_VERSION", "MEMBER_BID", "CC_CODE","METHOD_ID"]
    # Aggregate to method-level rows; carry forward first/representative values
    # for descriptive columns that will be needed downstream.
    # NOTE: We use IGNORENULLS where supported to avoid null dominance.
    df_suspected_gaps_method_confidence = (
        df.groupBy(*group_keys)
          .agg(
              F.max("CONFIDENCE_FACTOR").alias("METHOD_CONFIDENCE_FACTOR"),
              F.first("CC_DESCRIPTION", ignorenulls=True).alias("CC_DESCRIPTION"),
              F.first("SUPPRESSION1_YN", ignorenulls=True).alias("SUPPRESSION1_YN"),
              F.first("SUPPRESSION2_YN", ignorenulls=True).alias("SUPPRESSION2_YN"),
              F.first("SAS_MODEL_VERSION", ignorenulls=True).alias("SAS_MODEL_VERSION"),
              F.first("HOME_PLAN_ID_CD", ignorenulls=True).alias("HOME_PLAN_ID_CD"),
              F.first("SOURCE_LOAD_MONTH", ignorenulls=True).alias("SOURCE_LOAD_MONTH"),
              F.first("CLM_TP_CD", ignorenulls=True).alias("CLM_TP_CD"),
              F.first("CLAIM_BID", ignorenulls=True).alias("CLAIM_BID"),
              F.first("CLAIM_DT", ignorenulls=True).alias("CLAIM_DT"),
              F.first("DIAG_CD", ignorenulls=True).alias("DIAG_CD"),
              F.first("CHRONIC_HCC", ignorenulls=True).alias("CHRONIC_HCC"),
              F.first("CLAIM_CD_TYPE", ignorenulls=True).alias("CLAIM_CD_TYPE"),
              F.first("CLAIM_CD", ignorenulls=True).alias("CLAIM_CD"),
              F.first("PERCENT_WEIGHT", ignorenulls=True).alias("PERCENT_WEIGHT"),
              F.first("SAS_MODEL_YEAR", ignorenulls=True).alias("SAS_MODEL_YEAR"),
              F.first("CLAIM_CD_MODIFIER", ignorenulls=True).alias("CLAIM_CD_MODIFIER"),
              F.first("CLAIM_CD_MODIFIER_TYPE", ignorenulls=True).alias("CLAIM_CD_MODIFIER_TYPE"),
              F.first("EXCLUSION_1", ignorenulls=True).alias("EXCLUSION_1"),
              F.first("EXCLUSION_2", ignorenulls=True).alias("EXCLUSION_2"),
              F.first("EXCLUSION_TYPE_1", ignorenulls=True).alias("EXCLUSION_TYPE_1"),
              F.first("EXCLUSION_TYPE_2", ignorenulls=True).alias("EXCLUSION_TYPE_2"),
              F.first("QUALIFIED_CLAIM", ignorenulls=True).alias("QUALIFIED_CLAIM"),
              F.first("CLM_PMT_STS_CD", ignorenulls=True).alias("CLM_PMT_STS_CD"),
              F.first("TP_OF_BILL_CD", ignorenulls=True).alias("TP_OF_BILL_CD"),
              F.first("ALLWD_AMT", ignorenulls=True).alias("ALLWD_AMT"),
              F.first("CLM_LN_NUM", ignorenulls=True).alias("CLM_LN_NUM"),
              F.first("CPT_AND_HCPCS_CD", ignorenulls=True).alias("CPT_AND_HCPCS_CD"),
              F.first("DIAG_TYPE_CD", ignorenulls=True).alias("DIAG_TYPE_CD"),
              F.first("DIAG_NUM", ignorenulls=True).alias("DIAG_NUM"),
              F.first("PRINC_PROC_CD", ignorenulls=True).alias("PRINC_PROC_CD"),
              F.first("QUALIFY_CLAIMS", ignorenulls=True).alias("QUALIFY_CLAIMS"),
              F.first("INVALID_CPT_HCPCS", ignorenulls=True).alias("INVALID_CPT_HCPCS"),
              F.first("CODE", ignorenulls=True).alias("CODE"),
              F.first("GAP_REASON", ignorenulls=True).alias("GAP_REASON"),
              F.first("GAP_STATUS", ignorenulls=True).alias("GAP_STATUS"),
              F.first("MATCHED_CODE", ignorenulls=True).alias("MATCHED_CODE"),
              F.first("MATCHED_DATE", ignorenulls=True).alias("MATCHED_DATE"),
              F.first("SCENARIO_TYPE", ignorenulls=True).alias("SCENARIO_TYPE"),
              F.first("MATCHING_YN", ignorenulls=True).alias("MATCHING_YN"),
              F.first("SUPPRESSED_BY_PARENT", ignorenulls=True).alias("SUPPRESSED_BY_PARENT"),
              F.first("FREQUENCY", ignorenulls=True).alias("FREQUENCY"),
              F.first("CC_ID", ignorenulls=True).alias("CC_ID")
          )
    )
    logging.info(f"Completed Compute METHOD_CONFIDENCE_FACTOR--->")
    # -------------------------------------------------------------
    # Step 2: Enriching with 2 fields - CLAIM_TYPE and DX_SOURCE
    # -------------------------------------------------------------
    # Threshold filtering is now based on METHOD_CONFIDENCE_FACTOR (NOT row-level confidence)
    logging.info(f"Started Enriching with 2 fields - CLAIM_TYPE and DX_SOURCE--->")
    base_df = (
        df_suspected_gaps_method_confidence
        .withColumn("CLM_TP_CD_STR", F.col("CLM_TP_CD").cast("string"))
        .withColumn(
            "CLAIM_TYPE",
            F.when(F.col("CLM_TP_CD_STR") == "1", F.lit("facility-inpatient"))
             .when(F.col("CLM_TP_CD_STR") == "2", F.lit("facility-outpatient"))
             .when(F.col("CLM_TP_CD_STR") == "3", F.lit("professional"))
             .when(F.col("CLM_TP_CD_STR") == "4", F.lit("pharmacy"))
             .otherwise(F.lit(None).cast("string"))
        )
        .withColumn("DX_SOURCE", F.lit("suspected_gap"))
        # Normalize to 'YYYY-MM' for target CYCLE_RUN VARCHAR(7)
        .withColumn("CYCLE_RUN_NORM", F.substring(F.col("SOURCE_LOAD_MONTH"), 1, 7))
    )
    logging.info(f"Completed Enriching with 2 fields - CLAIM_TYPE and DX_SOURCE--->")
    # -------------------------------------------------------------------------------------
    # Join to risk_member_output_df to fetch member attributes and risk segment/type/version
    # -------------------------------------------------------------------------------------
    logging.info(f"Started Joining to risk_member_output_df to fetch member attributes and risk segment/type/version")
    rmo_df = load_risk_member_and_scores_df['risk_member_output_df']

    risk_member_base_df = (
        base_df.alias("base")
        .join(
            rmo_df.alias("rmo"),
            on=(
                (F.trim(F.col("base.HOME_PLAN_ID_CD")) == F.trim(F.col("rmo.HOME_PLAN_ID_CD"))) &
                (F.upper(F.trim(F.col("base.SAS_MODEL_VERSION"))) == F.upper(F.trim(F.col("rmo.SAS_MODEL_VERSION")))) &
                (F.upper(F.trim(F.col("base.MODEL_VERSION").cast("string"))) == F.upper(F.trim(F.col("rmo.RISK_MODEL_VERSION")))) &
                (F.col("base.MEMBER_BID") == F.col("rmo.MEMBER_BID")) &
                (F.col("base.RISK_YEAR") == F.col("rmo.RISK_YEAR"))
            ),
            how="left"
        )
        .select(
            F.col("base.*"),
            F.col("rmo.RISK_MODEL_TYPE"),
            F.col("rmo.RISK_MODEL_SEGMENT"),
            F.col("rmo.MEMBER_GENDER"),
            F.col("rmo.MEMBER_AGE"),
            F.col("rmo.SAS_MODEL_VERSION").alias("RMO_SAS_MODEL_VERSION")  # for debug if needed
        )
    )
    logging.info(f"Completed Joining to risk_member_output_df to fetch member attributes and risk segment/type/version")
    # ---------------------------------------------
    # Get coefficient scores by (model/segment/HCC)
    # ---------------------------------------------
    coeff_scores_df = load_risk_member_and_scores_df['coefficient_scores_df']
    # commented to handle negative CC_ID in below code
    # risk_member_base_df = (
    #     risk_member_base_df
    #     .withColumn("CC_NUM", F.regexp_extract(F.col("CC_CODE"), r'(\d+)$', 1).cast("int"))
    #     .withColumn(
    #         "EXPECTED_CC_CODE",
    #         F.when(
    #             F.col("CC_NUM").isNotNull() & F.col("RISK_MODEL_SEGMENT").isNotNull(),
    #             F.concat(F.col("RISK_MODEL_SEGMENT"), F.lit("_HCC"), F.col("CC_NUM").cast("string"))
    #         )
    #     )
    # )
    logging.info(f"Started Getting coefficient scores by (model/segment/HCC)")
    risk_member_base_df = (
        risk_member_base_df
        # Extract numeric suffix if present
        .withColumn(
            "CC_NUM",
            F.regexp_extract(F.col("CC_CODE"), r'(\d+)$', 1).cast("int")
        )
        # Build EXPECTED_CC_CODE
        .withColumn(
            "EXPECTED_CC_CODE",
            F.when(
                # Case 1: Letter + number CC codes (e.g., CC101)
                F.col("CC_NUM").isNotNull() & F.col("RISK_MODEL_SEGMENT").isNotNull(),
                F.concat(
                    F.col("RISK_MODEL_SEGMENT"),
                    F.lit("_HCC"),
                    F.col("CC_NUM").cast("string")
                )
            ).when(
                # Case 2: Letters-only CC codes (e.g., CANCER)
                F.col("CC_NUM").isNull() & F.col("RISK_MODEL_SEGMENT").isNotNull(),
                F.concat(
                    F.col("RISK_MODEL_SEGMENT"),
                    F.lit("_"),
                    F.col("CC_CODE")
                )
            )
        )
    )
    rmb = (
        risk_member_base_df
        .withColumn("RMT_norm", F.upper(F.trim(F.col("RISK_MODEL_TYPE"))))
        .withColumn("MV_norm",  F.upper(F.trim(F.col("MODEL_VERSION").cast("string"))))
        .withColumn("ECC_norm", F.upper(F.trim(F.col("EXPECTED_CC_CODE"))))
    )
    coef = (
        coeff_scores_df
        .withColumn("MODEL_norm",   F.upper(F.trim(F.col("MODEL"))))
        .withColumn("VERSION_norm", F.upper(F.trim(F.col("VERSION").cast("string"))))
        .withColumn("NAME_norm",    F.upper(F.trim(F.col("NAME"))))
    )
    join_cond = (
        (rmb["RMT_norm"] == coef["MODEL_norm"]) &
        (rmb["MV_norm"]  == coef["VERSION_norm"]) &
        (rmb["ECC_norm"] == coef["NAME_norm"])
    )

    risk_member_with_scores_df = (
        rmb
        .join(coef.select("MODEL_norm", "VERSION_norm", "NAME_norm", "SCORE"), join_cond, how="left")
        .drop("RMT_norm", "MV_norm", "ECC_norm")
    )
    logging.info(f"Completed Getting coefficient scores by (model/segment/HCC)")
    # ---------------------------------
    # Normalization/Adjustment factors
    # ---------------------------------
    adjustment_factors_df = load_risk_member_and_scores_df['adjustment_factors_df']

    logging.info(f"Started Normalization/Adjustment factors")

    risk_member_with_scores_df_final = (
        risk_member_with_scores_df.alias("base")
        .join(
            adjustment_factors_df.alias("nf"),
            (F.lower(F.col("base.MODEL_VERSION").cast("string")) == F.lower(F.col("nf.VERSION"))) &
            (F.lower(F.col("base.RISK_MODEL_TYPE")) == F.lower(F.col("nf.MODEL"))),
            "left"
        )
        .select("base.*", "nf.NORMALIZATION_FACTOR", "nf.CODING_PATTERN_ADJUSTMENT")
        .withColumn(
            "ADJ_COEFF_SCORE",
            round(
                (col("SCORE") / col("NORMALIZATION_FACTOR")) *
                (1 - col("CODING_PATTERN_ADJUSTMENT")),
                3
            )
        )
    )

    logging.info(f"Completed Normalization/Adjustment factors")

    # ----------------------------------------------------------------
    # Step 3: Compute COMBINED_CONFIDENCE_FACTOR across all methods
    #        for same (RISK_YEAR, MODEL_VERSION, MEMBER_BID, CC_CODE)
    # combined = 1 - Π (1 - METHOD_CONFIDENCE_FACTOR)
    # ----------------------------------------------------------------
    key_no_method = ["RISK_YEAR", "MODEL_VERSION", "MEMBER_BID", "CC_CODE"]

    logging.info(f"Started Computing COMBINED_CONFIDENCE_FACTOR")

    combined_by_key_df = (
        base_df
        .select(*key_no_method, "METHOD_ID", "METHOD_CONFIDENCE_FACTOR")
        .distinct()
        .groupBy(*key_no_method)
        .agg(
            F.expr(
                "1 - aggregate(collect_list(1.0 - METHOD_CONFIDENCE_FACTOR), 1.0D, (acc, x) -> acc * x)"
            ).alias("COMBINED_CONFIDENCE_FACTOR")
        )
    )
    enriched_df = (
        risk_member_with_scores_df_final.alias("base")
        .join(
            combined_by_key_df.alias("cmb"),
            on=[
                F.col("base.RISK_YEAR") == F.col("cmb.RISK_YEAR"),
                F.col("base.MODEL_VERSION") == F.col("cmb.MODEL_VERSION"),
                F.col("base.MEMBER_BID") == F.col("cmb.MEMBER_BID"),
                F.col("base.CC_CODE") == F.col("cmb.CC_CODE"),
            ],
            how="left"
        )
        .select("base.*", "cmb.COMBINED_CONFIDENCE_FACTOR")
    )

    logging.info(f"Completed Computing COMBINED_CONFIDENCE_FACTOR")
    # ------------------------------
    # Prepare final insert DataFrame
    # ------------------------------
    # Cast confidence fields to DECIMAL(5,4)
    enriched_df = (
        enriched_df
        .withColumn(
            "METHOD_CONFIDENCE_FACTOR_D",
            F.round(F.col("METHOD_CONFIDENCE_FACTOR"), 4).cast(DecimalType(5, 4))
        )
        .withColumn(
            "COMBINED_CONFIDENCE_FACTOR_D",
            F.round(F.col("COMBINED_CONFIDENCE_FACTOR"), 4).cast(DecimalType(5, 4))
        )
    )
    # Build the select list (align with target schema including new columns)
    logging.info(f"Started final insert_df for risk_member_hcc table")

    insert_df = (
        enriched_df.filter(F.col("COMBINED_CONFIDENCE_FACTOR") >= F.lit(threshold_percent))
        .select(
            F.col("MEMBER_BID").cast("bigint").alias("MEMBER_BID"),
            F.col("HOME_PLAN_ID_CD").alias("HOME_PLAN_ID_CD"),
            F.col("SAS_MODEL_YEAR").alias("RISK_MODEL_YEAR"),
            F.col("RISK_MODEL_TYPE"),
            F.substring(F.col("MODEL_VERSION").cast("string"), 1, 10).alias("RISK_MODEL_VERSION"),
            F.col("RISK_MODEL_SEGMENT"),
            F.substring(F.col("SAS_MODEL_VERSION").cast("string"), 1, 50).alias("SAS_MODEL_VERSION"),
            F.col("MEMBER_GENDER"),
            F.col("MEMBER_AGE"),
            F.lit("HCC").alias("RISK_TYPE_ID"),
            F.concat(F.lit("H"), F.col("CC_CODE")).alias("RISK_TYPE_DETAIL_ID"),  # CC_CODE is now uniform "CC###" across all methods
            F.col("CC_DESCRIPTION").alias("RISK_TYPE_DETAIL_DESC"),
            F.when(
                (F.coalesce(F.col("SUPPRESSION1_YN"), F.lit("N")) == "N") &
                (F.coalesce(F.col("SUPPRESSION2_YN"), F.lit("N")) == "N"),
                F.lit("R")
            ).when(
                (F.coalesce(F.col("SUPPRESSION1_YN"), F.lit("N")) == "Y") |
                (F.coalesce(F.col("SUPPRESSION2_YN"), F.lit("N")) == "Y"),
                F.lit("S")
            ).otherwise(F.lit(None).cast("string")).alias("SUPPRESSION_IND"),
            F.col("METHOD_ID").cast("int").alias("METHOD_ID"),
            F.col("ADJ_COEFF_SCORE"),
            F.col("SCORE").alias("COEFF_SCORE"),
            # >>> New fields as DECIMAL(5,4)
            F.col("METHOD_CONFIDENCE_FACTOR_D").alias("METHOD_CONFIDENCE_FACTOR"),
            F.col("COMBINED_CONFIDENCE_FACTOR_D").alias("COMBINED_CONFIDENCE_FACTOR"),
            # <<<
            (F.col("CHRONIC_HCC") if "CHRONIC_HCC" in df_suspected_gaps_all.columns
                else F.lit(None).cast("string")).alias("CHRONIC_HCC"),
            F.col("DX_SOURCE").alias("DX_SOURCE"),
            F.col("GAP_STATUS").cast("string").alias("GAP_STATUS"),  # If needed, set from DF (first) or keep null
            F.substring(F.col("CLAIM_TYPE").cast("string"), 1, 30).alias("CLAIM_TYPE"),
            F.col("CLAIM_BID").cast("bigint").alias("CLAIM_BID"),
            F.col("CLAIM_DT").cast("date").alias("CLAIM_DATE"),
            F.col("DIAG_CD").cast("string").alias("DIAG_CD"),
            F.col("RISK_YEAR").cast("int").alias("RISK_YEAR"),
            F.lit(None).cast("string").alias("HRA"),
            F.lit(None).cast("string").alias("HOME_HRA"),
            F.col("CYCLE_RUN_NORM").cast("string").alias("CYCLE_RUN"),
            F.lit(None).cast("string").alias("ACTIVE_IND"),
            F.lit(audit_metadata['created_date']).cast("timestamp").alias("CREATED_DATE"),
            F.lit(audit_metadata['created_by']).alias("CREATED_BY"),
            F.lit(audit_metadata['updated_date']).cast("timestamp").alias("UPDATED_DATE"),
            F.lit(audit_metadata['updated_by']).alias("UPDATED_BY"),
        )
        .distinct()
    )

    logging.info(f"Completed final insert_df for risk_member_hcc table")

    # -------------------------
    # Persist to target table
    # -------------------------
    # print(f"Homeplan --070 and member_bid--1100000000238228")
    # insert_df.filter(F.col("MEMBER_BID") == 1100000000238228).display()
    
    insert_df.createOrReplaceTempView("suspected_gaps_insert_view")

    logging.info(f"Started inserting into risk_member_hcc table")

    # IMPORTANT: Ensure the column order matches your table schema, including the two new columns.
    spark.sql(f"""
        INSERT INTO {catalog}.{curated_schema}.risk_member_hcc         SELECT             MEMBER_BID,             HOME_PLAN_ID_CD,             RISK_MODEL_YEAR,             RISK_MODEL_TYPE,             RISK_MODEL_VERSION,             RISK_MODEL_SEGMENT,             SAS_MODEL_VERSION,             MEMBER_GENDER,             MEMBER_AGE,             RISK_TYPE_ID,             RISK_TYPE_DETAIL_ID,             RISK_TYPE_DETAIL_DESC,             SUPPRESSION_IND,             METHOD_ID, ADJ_COEFF_SCORE,             COEFF_SCORE,   METHOD_CONFIDENCE_FACTOR,   COMBINED_CONFIDENCE_FACTOR,                 CHRONIC_HCC,             DX_SOURCE,  GAP_STATUS,             CLAIM_TYPE, CLAIM_BID,             CLAIM_DATE,             DIAG_CD,             RISK_YEAR,             HRA,             HOME_HRA,             CYCLE_RUN,             ACTIVE_IND,             CREATED_DATE,             CREATED_BY,             UPDATED_DATE,             UPDATED_BY
        FROM suspected_gaps_insert_view
    """)
    
    logging.info(f"Completed inserting into risk_member_hcc table")

    return insert_df

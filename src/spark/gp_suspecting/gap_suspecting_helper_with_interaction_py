                logger.error(f"Invalid method_id: {mid}")
                raise Exception("Invalid method_id")

        except Exception as e:
            logger.error(f"Error processing method_id {mid}: {str(e)}")
            raise

    # Union everything collected
    if dfs_to_union:
        logger.info("Unioning DataFrames produced by the requested methods.")
        final_df = reduce(
            lambda a, b: a.unionByName(b, allowMissingColumns=True),
            dfs_to_union
        )
        logger.info(f"final_df columns after union: {final_df.columns}")
        # logger.info(f"final_df total records after union: {final_df.count()}")
    else:

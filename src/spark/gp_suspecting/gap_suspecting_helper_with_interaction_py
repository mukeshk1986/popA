def read_risk_member_output(spark, catalog, schema_curation, time_period_list, ma_schema, source_load_year_month):
    query_rmo = f"""
        SELECT rmo.RISK_MEMBER_ID as MEMBER_BID, 
               rmo.HOME_PLAN_ID_CD, 
               rmo.RISK_MODEL_VERSION,
               rmo.YEAR_MONTH, 
               rmo.DIAG_CD_TO_HCC_JSON_LIST ,
               YEAR(tp.BEGIN_DATE) as RISK_YEAR,
               rmo.RISK_MODEL_TYPE,
               rmo.RISK_MODEL_SEGMENT,
               rmo.MEMBER_GENDER,
               rmo.MEMBER_AGE,
               rmo.SAS_MODEL_VERSION,
               rmo.CYCLE_RUN_DATE
        FROM {catalog}.{schema_curation}.risk_member_output rmo
        INNER JOIN 
        {catalog}.{ma_schema}.time_periods as tp
        on rmo.TIME_PERIOD = tp.TIME_PERIOD AND tp.TIME_PERIOD_TYPE_CD='C'
        WHERE rmo.TIME_PERIOD IN ({time_period_list})
        AND rmo.YEAR_MONTH = '{source_load_year_month}'
    """
    df_rmo = spark.sql(query_rmo)
    return df_rmo 

def generate_member_cc_with_BID(spark, df_member_cc_with_BID: DataFrame) -> DataFrame:
    """
    Generate member CC (Condition Category) codes from risk member output.
    
    Retrieves risk member HCC data and extracts up to 30 CC codes per member
    from JSON arrays. Creates CC_Code1 through CC_Code30 columns with formatted
    CC codes (e.g., "CC001", "CC019", "CC085").
    
    Args:
        spark: SparkSession instance
        catalog: Catalog name
        schema_curation: Curated schema name
        time_period_list: Comma-separated list of time periods to filter
    
    Returns:
        DataFrame with columns:
        - MEMBER_BID: Member business ID
        - HOME_PLAN_ID_CD: Plan identifier
        - RISK_MODEL_YEAR: Risk model year
        - RISK_MODEL_VERSION: Model version (v24/v28)
        - YEAR_MONTH: Year-month identifier
        - CC_Code1 through CC_Code30: Formatted CC codes ("CC###")
        
    CC Code Extraction:
        - Extracts from DIAG_CD_TO_HCC_JSON_LIST array
        - Supports both V24 and V28 model categories
        - Formats as "CC" + zero-padded 3-digit number
        - NULL if position doesn't exist or no valid code
        
    Note:
        Used for matching gaps against member's existing HCC conditions
        to determine if gap already exists (MATCHING_YN flag).
    """
    for i in range(100):
        cc_col_name = f"CC_Code{i+1}"
        df_member_cc_with_BID = df_member_cc_with_BID.withColumn(
            cc_col_name,
            when(
                size(col("DIAG_CD_TO_HCC_JSON_LIST")) > i,
                when(
                    length(regexp_extract(col("DIAG_CD_TO_HCC_JSON_LIST")[i], r"(?i)'cms-hcc-model-category-v28':(\d+)", 1)) > 0,
                    concat(lit("CC"), lpad(regexp_extract(col("DIAG_CD_TO_HCC_JSON_LIST")[i], r"(?i)'cms-hcc-model-category-v28':(\d+)", 1), 3, "0"))
                ).when(
                    length(regexp_extract(col("DIAG_CD_TO_HCC_JSON_LIST")[i], r"(?i)'cms-hcc-model-category-v24':(\d+)", 1)) > 0,
                    concat(lit("CC"), lpad(regexp_extract(col("DIAG_CD_TO_HCC_JSON_LIST")[i], r"(?i)'cms-hcc-model-category-v24':(\d+)", 1), 3, "0"))
                ).otherwise(
                    lit("")
                )
            ).otherwise(lit(None).cast(StringType()))
        )
    return df_member_cc_with_BID

# Added model version in join condition
def join_gap_with_member_cc_optimized(df_draft_gap_with_version, df_member_cc_with_BID):
    # Unpivot CC codes — alias RISK_MODEL_VERSION → MODEL_VERSION
    df_member_cc_unpivoted = df_member_cc_with_BID.select(
        "MEMBER_BID",
        col("RISK_MODEL_VERSION").alias("MODEL_VERSION"),
        "RISK_YEAR",
        "HOME_PLAN_ID_CD",
        explode(array([col(f"CC_Code{i}") for i in range(1, 101)])).alias("CC_CODE")
    ).filter(col("CC_CODE").isNotNull()) \
     .withColumn("_MATCHED", lit(True))  # sentinel to detect successful join

    # Left join — _MATCHED will be null when no CC match found
    return df_draft_gap_with_version.join(
        df_member_cc_unpivoted,
        ["MEMBER_BID", "RISK_YEAR", "CC_CODE", "MODEL_VERSION"],
        "left"
    ).withColumn(
        "MATCHING_YN",
        when(col("_MATCHED").isNotNull(), "Y").otherwise("N")
    ).drop("_MATCHED") \
     .select(df_draft_gap_with_version["*"], "MATCHING_YN") \
     .distinct()

#hierarchy_config
def get_ref_hierarchy(spark, catalog: str, ma_reference: str) -> DataFrame:
    """
    Retrieve HCC hierarchy configuration from reference data.
    
    Fetches parent-child relationships for Hierarchical Condition Categories (HCC)
    used in suppression logic. When a parent HCC exists, child HCCs are suppressed
    according to CMS risk adjustment rules.
    
    Args:
        spark: SparkSession instance
        catalog: Catalog name
        ma_reference: Reference schema name
    
    Returns:
        DataFrame with columns:
        - version: Model version (e.g., 'v24', 'v28')
        - parent: Parent HCC code (integer)
        - child: Comma-separated child HCC codes (string)
        - model: Model type (filtered to 'cms_hcc')
        
    Ordered by: version, parent
        
    Usage:
        Used in two_level_suppression_logic_final() to:
        1. Identify which child HCCs should be suppressed when parent exists
        2. Apply CMS hierarchy rules to prevent double-counting
        3. Generate SUPPRESSION1_YN and SUPPRESSION2_YN flags
        
    Example:
        Parent HCC 85 suppresses children 86, 87, 88
        If member has HCC 85, then HCC 86/87/88 are suppressed
    """
    query = f"""
        SELECT version, parent, child, model 
        FROM {catalog}.{ma_reference}.hierarchy_config 
        WHERE model = 'cms_hcc' 
        ORDER BY version, parent
    """
    return spark.sql(query)


def combine_gap_with_version_suppression(df_final_gap: DataFrame, df_final_gap_with_suppression: DataFrame ) -> DataFrame:
    """
    Drops 'CC_CODE' from df_final_gap and joins with df_final_gap_with_suppression
    on MEMBER_BID, MODEL_VERSION, and RISK_YEAR. Returns the combined DataFrame.
    """
    # df_final_gap_clean = df_final_gap.drop("CC_CODE")
    df_gap_with_version_suppression = df_final_gap.alias("gap").join(
        df_final_gap_with_suppression.alias("supp"),
        (F.col("gap.MEMBER_BID") == F.col("supp.MEMBER_BID")) &
        (F.col("gap.MODEL_VERSION") == F.col("supp.MODEL_VERSION")) &
        (F.col("gap.RISK_YEAR") == F.col("supp.RISK_YEAR")) &
        (F.col("gap.CC_CODE") == F.col("supp.CC_CODE")),
        "left_outer"
    ).select(
        *[F.col(f"gap.{c}") for c in df_final_gap.columns],
        *[F.col(f"supp.{c}").alias(f"{c}") 
          for c in df_final_gap_with_suppression.columns 
          if c not in ["MEMBER_BID", "MODEL_VERSION", "RISK_YEAR", "CC_CODE"]]
    ).distinct()
    
    return df_gap_with_version_suppression

def add_create_gap_status_column(df: DataFrame) -> DataFrame:
    """
    Filters the DataFrame to only include rows where:
    MATCHING_YN = 'N', SUPPRESSION1_YN = 'N', and SUPPRESSION2_YN = 'N'.
    
    For these filtered rows, sets GAP_STATUS to 'Open Suspect' and adds CREATE_GAP = 'Y'.
    """
    
    return df.filter(
        (F.col("MATCHING_YN") == "N") & 
        (F.coalesce(F.col("SUPPRESSION1_YN"), F.lit("N")) == "N") & 
        (F.coalesce(F.col("SUPPRESSION2_YN"), F.lit("N")) == "N")
    ).withColumn(
        "CREATE_GAP", F.lit("Y")
    ).withColumn(
        "GAP_STATUS", F.lit("Open Suspect")
    )
    
def load_risk_member_and_reference_data(spark, catalog, schema, schema_curation, ma_reference, df_member_output):
    """
    Load the latest risk member output data and reference tables.
    
    Args:
        spark (SparkSession): Active Spark session
        catalog (str): Catalog name
        schema (str): Schema name for medical claims
        schema_curation (str): Schema name for curated tables
        ma_reference (str): Schema name for reference tables
    
    Returns:
        dict: Dictionary containing the following DataFrames:
            - 'risk_member_output_df': Latest risk member output data
            - 'coefficient_scores_df': coefficient_scores reference data
            - 'adjustment_factors_df': adjustment_factors reference data
            - 'latest_year_month': Latest YEAR_MONTH value
            - 'latest_cycle': Latest CYCLE_RUN_DATE value (overall max)
    
    Raises:
        ValueError: If required tables don't exist or no data is found
        Exception: For any other unexpected errors during execution
    """
    
    try:
        # ========================================================================
        # Phase 1: Load Latest Risk Member Output Data
        # For the latest YEAR_MONTH, retrieves the latest CYCLE_RUN_DATE per SAS_MODEL_VERSION
        # ========================================================================

        # risk_member_table = f"{catalog}.{schema_curation}.risk_member_output"
        # logging.info(f"Source table: {risk_member_table}")

        # # Validate table exists
        # try:
        #     if not spark.catalog.tableExists(risk_member_table):
        #         raise ValueError(f"Table {risk_member_table} does not exist")
        # except Exception as e:
        #     logging.error(f"Error checking table existence for {risk_member_table}: {str(e)}")
        #     raise Exception(f"Failed checking table existence for {risk_member_table}: {str(e)}")

        # Step 1: Get the latest YEAR_MONTH (minimal scan)
        try:
            logging.info("Step 1: Getting latest YEAR_MONTH")
            latest_year_month_row = (
                # spark.table(risk_member_table)
                    df_member_output
                    .select("YEAR_MONTH")
                    .distinct()
                    .agg(spark_max("YEAR_MONTH").alias("max_ym"))
                    .first()
            )
            
            if latest_year_month_row is None or latest_year_month_row["max_ym"] is None:
                raise ValueError(f"No data found in {df_member_output}")
                
            latest_year_month = latest_year_month_row["max_ym"]
            logging.info(f"Latest YEAR_MONTH identified: {latest_year_month}")
            
        except Exception as e:
            logging.error(f"Error getting latest YEAR_MONTH: {str(e)}")
            raise Exception(f"Failed getting latest YEAR_MONTH: {str(e)}")

        # Step 2: Read only the latest YEAR_MONTH partition
        try:
            logging.info("Step 2: Filtering data for latest YEAR_MONTH")
            df_latest_month = (
                # spark.table(risk_member_table)
                df_member_output
                    .filter(col("YEAR_MONTH") == latest_year_month)
            )
            
            if not df_latest_month.head(1):
                raise ValueError(f"No records found for YEAR_MONTH {latest_year_month}")
                
            logging.info(f"Data found for YEAR_MONTH {latest_year_month}")
            
        except Exception as e:
            logging.error(f"Error filtering data for YEAR_MONTH {latest_year_month}: {str(e)}")
            raise Exception(f"Failed filtering data for YEAR_MONTH {latest_year_month}: {str(e)}")

        # Step 3: Compute latest cycle per SAS_MODEL_VERSION
        try:
            logging.info("Step 3: Getting latest CYCLE_RUN_DATE per SAS_MODEL_VERSION")
            max_cycle_per_version = (
                df_latest_month
                .groupBy("SAS_MODEL_VERSION")
                .agg(spark_max("CYCLE_RUN_DATE").alias("MAX_CYCLE_RUN_DATE"))
            )
                
        except Exception as e:
            logging.error(f"Error computing latest cycle per version: {str(e)}")
            raise Exception(f"Failed computing latest cycle per version: {str(e)}")

        # Step 4: Keep rows that match each version's latest cycle
        try:
            logging.info("Step 4: Filtering rows for each version's latest cycle within latest YEAR_MONTH")
            risk_member_output_df = (
                df_latest_month.alias("rm")
                .join(
                    max_cycle_per_version.alias("mx"),
                    (col("rm.SAS_MODEL_VERSION") == col("mx.SAS_MODEL_VERSION")) &
                    (col("rm.CYCLE_RUN_DATE") == col("mx.MAX_CYCLE_RUN_DATE")),
                    "inner"
                )
                .select("rm.*")  # Select only original columns, exclude MAX_CYCLE_RUN_DATE
            )
            
            # Final validation
            if not risk_member_output_df.head(1):
                raise ValueError("No rows matched latest cycle per version")
            
            logging.info(
                f"Final data loaded for YEAR_MONTH {latest_year_month} "
            )
            
        except Exception as e:
            logging.error(f"Error applying per-version cycle filter: {str(e)}")
            raise Exception(f"Failed applying per-version cycle filter: {str(e)}")

        # Step 5: Compute overall latest cycle for return value
        try:
            logging.info("Step 5: Computing overall latest CYCLE_RUN_DATE")
            latest_cycle_row = (
                risk_member_output_df
                .select(spark_max("CYCLE_RUN_DATE").alias("max_cycle"))
                .first()
            )
            latest_cycle = latest_cycle_row["max_cycle"] if latest_cycle_row else None
            logging.info(f"Overall latest CYCLE_RUN_DATE: {latest_cycle}")
            
        except Exception as e:
            logging.error(f"Error computing overall latest cycle: {str(e)}")
            raise Exception(f"Failed computing overall latest cycle: {str(e)}")
            
        # ========================================================================
        # Phase 2: Load Transform and Reference Tables
        # ========================================================================
        logging.info("-" * 80)
        logging.info("Phase 2: Loading Transform and Reference Tables")
        logging.info("-" * 80)

        # Load coefficient scores reference data
        try:
            coefficient_scores_table = f"{catalog}.{ma_reference}.coefficient_scores"
            logging.info(f"Loading table: {coefficient_scores_table}")
            if not spark.catalog.tableExists(coefficient_scores_table):
                raise ValueError(f"Required table {coefficient_scores_table} does not exist")
            
            coefficient_scores_df = spark.table(coefficient_scores_table)
            logging.info(f"Successfully loaded {coefficient_scores_table}")
            
            if not coefficient_scores_df.head(1):
                logging.warning(f"Table {coefficient_scores_table} is empty")
        except Exception as e:
            logging.error(f"Error loading {coefficient_scores_table}: {str(e)}")
            raise Exception(f"Failed to load {coefficient_scores_table}: {str(e)}")
            
        # Load adjustment_factors reference data
        try:
            adjustment_factors_table = f"{catalog}.{ma_reference}.adjustment_factors"
            logging.info(f"Loading table: {adjustment_factors_table}")
            if not spark.catalog.tableExists(adjustment_factors_table):
                raise ValueError(f"Required table {adjustment_factors_table} does not exist")
            
            adjustment_factors_df = spark.table(adjustment_factors_table)
            logging.info(f"Successfully loaded {adjustment_factors_table}")
            
            if not adjustment_factors_df.head(1):
                logging.warning(f"Table {adjustment_factors_table} is empty")
        except Exception as e:
            logging.error(f"Error loading {adjustment_factors_table}: {str(e)}")
            raise Exception(f"Failed to load {adjustment_factors_table}: {str(e)}")
        
        logging.info("All reference tables loaded successfully")
        
        # Return all loaded data
        return {
            'risk_member_output_df': risk_member_output_df,
            'coefficient_scores_df': coefficient_scores_df,
            'adjustment_factors_df': adjustment_factors_df,
            'latest_year_month': latest_year_month,
            'latest_cycle': latest_cycle
        }
    
    except ValueError as ve:
        logging.error(f"Validation error: {str(ve)}")
        raise
    except Exception as e:
        logging.error(f"Unexpected error in load_risk_member_and_reference_data: {str(e)}")
        raise Exception(f"Failed in load_risk_member_and_reference_data: {str(e)}")


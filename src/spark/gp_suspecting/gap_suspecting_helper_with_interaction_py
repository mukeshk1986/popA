def get_medical_professional_all(spark, catalog: str, schema: str, risk_year: int, no_of_year: int) -> DataFrame:
    """
    Retrieve all professional (physician) claims with diagnoses.
    
    Fetches professional claims joined with diagnosis codes for the specified
    time period. Includes claims with qualified visit indicators.
    
    Args:
        catalog: Catalog name
        schema: Schema name
        risk_year: Target risk year
        no_of_year: Number of years to include (1=current year, 2=current+prior)
    
    Returns:
        DataFrame with professional claims and associated diagnoses
        
    Note:
        - Filters to p.risk_year >= {start_year} and CLM_TP_CD = 3 (professional)
        - Joins medical_claims with professional_diag
    """
    # Convert parameters to integers
    risk_year = int(risk_year)
    no_of_year = int(no_of_year)
    start_year = risk_year - no_of_year + 1
    
    return spark.sql(f"""
        SELECT DISTINCT 
            p.CLAIM_BID,
            p.MEMBER_BID,
            p.CLM_PMT_STS_CD,        
            p.CLM_TP_CD,        
            p.TP_OF_BILL_CD,
            p.LAST_SERV_DT as CLAIM_DT,
            p.ALLWD_AMT,
            p.SOURCE_LOAD_MONTH,
            p.CLM_LN_NUM,
            p.CPT_AND_HCPCS_CD,
            pd.DIAG_TYPE_CD,
            pd.DIAG_NUM,
            pd.DIAG_CD,
            '' as PRINC_PROC_CD,
            p.QUALIFY_CLAIMS,
            p.INVALID_CPT_HCPCS,
            p.HOME_PLAN_ID_CD
        FROM {catalog}.{schema}.medical_claims p 
        INNER JOIN {catalog}.{schema}.professional_diag pd 
            ON p.CLAIM_BID = pd.PROFESSIONAL_BID
        WHERE p.risk_year between  {start_year} and {risk_year}
            AND p.CLM_TP_CD = 3 
    """)


def get_medical_facility_all(spark, catalog: str, schema: str, risk_year: int, no_of_year: int) -> DataFrame:
    """
    Retrieve all facility (institutional) claims with diagnoses.
    
    Fetches facility claims joined with diagnosis codes and procedure codes
    for the specified time period.
    
    Args:
        catalog: Catalog name
        schema: Schema name
        risk_year: Target risk year
        no_of_year: Number of years to include (1=current year, 2=current+prior)
    
    Returns:
        DataFrame with facility claims and associated diagnoses/procedures
        
    Note:
        - Filters to CLM_TP_CD in (1,2) (facility)
        - Joins medical_claims with facility_diag and facility_header
    """
    # Convert parameters to integers
    risk_year = int(risk_year)
    no_of_year = int(no_of_year)
    start_year = risk_year - no_of_year + 1
    
    return spark.sql(f"""
        SELECT DISTINCT 
            m.CLAIM_BID,
            m.MEMBER_BID,
            m.CLM_PMT_STS_CD,        
            m.CLM_TP_CD,        
            m.TP_OF_BILL_CD,
            m.STMT_THRU_DT as CLAIM_DT,
            m.ALLWD_AMT,
            m.SOURCE_LOAD_MONTH,
            m.CLM_LN_NUM,
            m.CPT_AND_HCPCS_CD,
            fd.DIAG_TYPE_CD,
            fd.DIAG_NUM,
            fd.DIAG_CD,
            fh.PRINC_PROC_CD,
            m.QUALIFY_CLAIMS,
            m.INVALID_CPT_HCPCS,
            m.HOME_PLAN_ID_CD
        FROM {catalog}.{schema}.medical_claims m 
        INNER JOIN {catalog}.{schema}.facility_diag fd
            ON m.CLAIM_BID = fd.FACILITY_BID
        INNER JOIN {catalog}.{schema}.facility_header fh
            ON m.CLAIM_BID = fh.FACILITY_BID
            AND fd.FACILITY_BID = fh.FACILITY_BID
        WHERE m.risk_year between {start_year} and {risk_year}
            AND m.CLM_TP_CD IN (1,2)
    """)

def get_pharmacy_df(spark, catalog: str, schema: str, risk_year: int, no_of_year: int) -> DataFrame:
    """
    Retrieve pharmacy/prescription claims.
    
    Fetches pharmacy claims for the specified time period used in
    Method 1 gap suspecting (NDC-based gaps).
    
    Args:
        catalog: Catalog name
        schema: Schema name
        risk_year: Target risk year
        no_of_year: Number of years to include (1=current year, 2=current+prior)
    
    Returns:
        DataFrame with pharmacy claims
        
    Note:
        - Filter for only valid MEMBER_BID
        - Service date year used for time filtering
    """
    # Convert parameters to integers
    risk_year = int(risk_year)
    no_of_year = int(no_of_year)
    start_year = risk_year - no_of_year + 1
    
    query = f"""
        SELECT * 
        FROM {catalog}.{schema}.pharmacy 
        WHERE year(SERV_DT) between {start_year} and {risk_year}
            AND MEMBER_BID > 0
    """
    return spark.sql(query)


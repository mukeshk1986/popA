            elif mid == "4":
                # Method 4: persistent integration to Suspected Gaps table
                method4_df = method4_integration_with_suspected_gaps(
                    spark, catalog, gap_schema_curation, source_load_year_month,
                    risk_year, no_of_year, mid, audit_metadata, logger, save_table
                )

                if method4_df is not None:
                    dfs_to_union.append(method4_df)
                    logger.info(f"method4_df running")

def get_method_metadata_df(spark, catalog: str, ma_reference: str, ref_table_name: str) -> DataFrame:
    """
    Retrieve method metadata from reference tables.
    
    Args:
        spark: SparkSession instance
        catalog: Catalog name
        ma_reference: Reference schema name
        ref_table_name: Reference table name to query
    
    Returns:
        DataFrame containing method metadata
    """
    df_method_metadata = spark.table(f"{catalog}.{ma_reference}.{ref_table_name}")
    return df_method_metadata

def get_method_wise_inclusion(spark, df_method_metadata, method_id) -> DataFrame:
    """
    Filter method metadata for inclusion logic (no exclusions).
    
    Retrieves method metadata for specified METHOD_ID where:
    - PROGRAM = 'CMS'
    - EXCLUSION_TYPE_1 = 'NA' (no exclusion rules)
    
    Args:
        spark: SparkSession instance
        df_method_metadata: Source method metadata DataFrame
        method_id: Method ID to filter (1, 2, or 10)
    
    Returns:
        DataFrame filtered to inclusion-only method metadata
    """
    df_method_metadata_inclusion = (
        df_method_metadata
        .filter(
            (col("METHOD_ID") == method_id) &
            (col("PROGRAM") == "CMS") &
            (col("EXCLUSION_TYPE_1") == "NA")
        )
        .select("*")
    )
    return df_method_metadata_inclusion

def get_method_metadata_inclusion_10(spark, catalog: str, ma_reference: str, df_method_metadata: DataFrame) -> DataFrame:
    """
    Filter method metadata for METHOD_ID 10 inclusion logic.
    
    Retrieves method metadata specifically for METHOD_ID 10 where:
    - PROGRAM = 'CMS'
    - EXCLUSION_TYPE_1 = 'NA' (no exclusion rules)
    - Used for procedure-based gap suspecting
    
    Args:
        spark: SparkSession instance
        catalog: Catalog name
        ma_reference: Reference schema name
        df_method_metadata: Source method metadata DataFrame
    
    Returns:
        DataFrame filtered to METHOD_ID 10 inclusion metadata
    """
    df_method_metadata_inclusion = (
        df_method_metadata
        .filter(
            (col("METHOD_ID") == 10) &
            (col("PROGRAM") == "CMS") &
            (col("EXCLUSION_TYPE_1") == "NA")
        )
        .select("*")
    )
    return df_method_metadata_inclusion

def join_method_icd_hcc(df_method_metadata_inclusion: DataFrame, df_hcc_main: DataFrame ) -> DataFrame:
    """
    Join method metadata with ICD-HCC mapping.
    
    Joins method metadata containing diagnosis codes with the ICD-HCC reference
    to get HCC category mappings.
    
    Args:
        df_method_metadata_inclusion: Method metadata with claim codes
        df_hcc_main: ICD-HCC mapping reference data
    
    Returns:
        DataFrame with method metadata enriched with HCC mappings
    """
    return (
        df_method_metadata_inclusion
        .join(
            df_hcc_main,
            ((col("CLAIM_CD_TYPE") == 'DIAGNOSIS') & 
             (col("CLAIM_CD") == col("diagnosiscode"))),
            "inner"
        )
        .select(
            # col("METHOD_ID"),
            # col("CLAIM_CD_TYPE"),
            # col("CLAIM_CD"),
            # col("CC_ID"),
            col("*")
        )
    )


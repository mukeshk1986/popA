def insert_risk_member_hcc_summary(spark, catalog: str, curated_schema: str, risk_member_hcc: DataFrame, dedupe_subset: List[str], logger):

    drop_cols = ["CLAIM_TYPE", "CLAIM_BID", "CLAIM_DATE", "DIAG_CD"]

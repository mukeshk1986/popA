def create_draft_gap_M2(df_method_metadata_with_cc_code: DataFrame, df_final_medical_claims_all: DataFrame ) -> DataFrame:
    """
    Create draft gaps for Method 2 (Diagnosis/Procedure-based gaps).
    
    Identifies potential gaps by matching diagnosis codes, CPT-HCPCS codes,
    or ICD procedure codes from medical claims with method metadata.
    Applies qualified claim logic.
    
    Args:
        df_method_metadata_with_cc_code: Method metadata with CC code mappings
        df_final_medical_claims_all: Combined facility and professional claims
    
    Returns:
        DataFrame with draft gaps identified from medical claims
        
    Gap Logic:
        - Matches DIAGNOSIS, CPT-HCPCS, or ICD-PROC codes
        - If QUALIFIED_CLAIM = 0: All matches flagged as "Create Gap"
        - If QUALIFIED_CLAIM = 1: Only qualified claims (QUALIFY_CLAIMS='Y') flagged as "Create Gap"
        - Others marked as "DO NOT Create Gap"
    """
    return (
        df_method_metadata_with_cc_code.alias("inc")
        .join(
            df_final_medical_claims_all.alias("all_claim"),
            (
                # Match diagnosis codes
                (
                    (col("inc.CLAIM_CD_TYPE") == "DIAGNOSIS") & 
                    (col("inc.CLAIM_CD") == col("all_claim.DIAG_CD"))
                ) |
                # Match CPT-HCPCS codes
                (
                    (col("inc.CLAIM_CD_TYPE") == "CPT-HCPCS") & 
                    (col("inc.CLAIM_CD") == col("all_claim.CPT_AND_HCPCS_CD"))
                ) |
                # Match ICD procedure codes
                (
                    (col("inc.CLAIM_CD_TYPE") == "ICD-PROC") & 
                    (col("inc.CLAIM_CD") == col("all_claim.PRINC_PROC_CD"))
                )
            ),
            "inner"
        )
        .select(
            col("inc.METHOD_ID"),
            col("inc.CLAIM_CD_TYPE"),
            col("inc.CLAIM_CD"),
            col("inc.CC_ID"),
            col("inc.PERCENT_WEIGHT"),
            col("inc.CC_CODE"),
            col("inc.CC_DESCRIPTION"),
            col("inc.CHRONIC_HCC"),                       
            col("inc.SAS_MODEL_YEAR"),
            col("inc.SAS_MODEL_VERSION"),
            col("inc.CLAIM_CD_MODIFIER"), 
            col("inc.CLAIM_CD_MODIFIER_TYPE"),
            col("inc.EXCLUSION_1"),
            col("inc.EXCLUSION_2"), 
            col("inc.EXCLUSION_TYPE_1"), 
            col("inc.EXCLUSION_TYPE_2"),
            col("inc.QUALIFIED_CLAIM"),
            year(col("all_claim.claim_dt")).alias("RISK_YEAR"),
            col("all_claim.*"),
            lit("NA").alias("CODE"),
            when(
                (col("inc.QUALIFIED_CLAIM") == 0),
                lit("Inclusion - Suspecting Diagnosis")
            ).when(
                (col("inc.QUALIFIED_CLAIM") == 1) & (col("all_claim.QUALIFY_CLAIMS") == "Y"),
                lit("Inclusion - Suspecting Diagnosis")
            ).otherwise(
                lit("Inclusion - Claim is not qualified")
            ).alias("GAP_REASON"),
            when(
                (col("inc.QUALIFIED_CLAIM") == 0),
                lit("Create Gap")
            ).when(
                (col("inc.QUALIFIED_CLAIM") == 1) & (col("all_claim.QUALIFY_CLAIMS") == "Y"),
                lit("Create Gap")
            ).otherwise(
                lit("DO NOT Create Gap")
            ).alias("GAP_STATUS"),
            lit("NA").alias("MATCHED_CODE"), 
            lit("").alias("MATCHED_DATE"),
            lit("Inclusion Logic").alias("SCENARIO_TYPE")
        )
    )


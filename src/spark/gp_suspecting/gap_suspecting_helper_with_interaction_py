def create_draft_gap_M1(df_method_metadata_with_cc_code: DataFrame, df_pharmacy: DataFrame) -> DataFrame:
    """
    Create draft gaps for Method 1 (Pharmacy/NDC-based gaps).
    
    Identifies potential gaps by matching pharmacy NDC codes with method metadata.
    Method 1 focuses on prescription drug-based gap identification.
    
    Args:
        df_method_metadata_with_cc_code: Method metadata with CC code mappings
        df_pharmacy: Pharmacy claims data
    
    Returns:
        DataFrame with draft gaps identified from pharmacy claims
        
    Gap Logic:
        - Matches NDC codes from pharmacy claims with CLAIM_CD in metadata
        - All matched pharmacy claims are flagged as "Create Gap"
        - Assigns CLM_TP_CD = 4 (pharmacy claim type)
    """
    return (
        df_method_metadata_with_cc_code.alias("inc")
        .join(
            df_pharmacy.alias("RX_claim"),
            (
                (col("inc.CLAIM_CD_TYPE") == "NDC") & 
                (col("inc.CLAIM_CD") == col("RX_claim.PROD_SERV_ID_CD"))
            ),
            "inner"
        )
        .select(
            # Method metadata columns
            col("inc.METHOD_ID"),
            col("inc.CLAIM_CD_TYPE"),
            col("inc.CLAIM_CD"),
            col("inc.CC_ID"),
            col("inc.PERCENT_WEIGHT"),
            col("inc.CC_CODE"),
            col("inc.CC_DESCRIPTION"),
            col("inc.CHRONIC_HCC"),                       
            col("inc.SAS_MODEL_YEAR"),
            col("inc.SAS_MODEL_VERSION"),
            col("inc.CLAIM_CD_MODIFIER"), 
            col("inc.CLAIM_CD_MODIFIER_TYPE"),
            col("inc.EXCLUSION_1"),
            col("inc.EXCLUSION_2"), 
            col("inc.EXCLUSION_TYPE_1"), 
            col("inc.EXCLUSION_TYPE_2"),
            col("inc.QUALIFIED_CLAIM"),
            # Pharmacy claim details
            year(col("RX_claim.serv_dt")).alias("RISK_YEAR"),
            col("RX_claim.PHARMACY_BID").alias("CLAIM_BID"),
            col("RX_claim.MEMBER_BID"),
            col("RX_claim.CLM_PMT_STS_CD"),
            lit("4").alias("CLM_TP_CD"),  # Pharmacy claim type
            lit("").alias("TP_OF_BILL_CD"),
            col("RX_claim.SERV_DT").alias("CLAIM_DT"),
            col("RX_claim.ALLWD_AMT"),
            col("RX_claim.SOURCE_LOAD_MONTH"),

    df_risk_member_hcc_summary = (
        risk_member_hcc
        .drop(*drop_cols)
        .dropDuplicates(subset=dedupe_subset)
    )
    df_risk_member_hcc_summary.write.insertInto(f"{catalog}.{curated_schema}.risk_member_hcc_summary", overwrite=False)
    logger.info(f"Data appended to: {catalog}.{curated_schema}.risk_member_hcc_summary")
    return df_risk_member_hcc_summary
   
def insert_interaction_coefficient_risk_member_hcc(
    spark,
    catalog: str,
    schema_curation: str,
    ma_reference: str,
    source_load_year_month: str,
    suspected_gaps_df: DataFrame,
    audit_metadata: dict,
    logger
):
    """
    Creates and inserts HCC disease interaction coefficient records
    into risk_member_hcc table.
    """

    logger.info("Starting insert_interaction_coefficient_risk_member_hcc")

    # Step 1: Load reference interaction scores
    df_ref_interaction_scores = (
        spark.table(f"{catalog}.{ma_reference}.ref_interaction_scores")
        .select(
            F.col("SAS_MODEL_VERSION").alias("sas_model_version"),
            F.col("RISK_MODEL_SEGMENT").alias("risk_model_segment"),
            F.least(F.col("INTERACTION_HCC1"), F.col("INTERACTION_HCC2")).alias("hcc_code_1"),
            F.greatest(F.col("INTERACTION_HCC1"), F.col("INTERACTION_HCC2")).alias("hcc_code_2"),
            F.col("INTERACTION_NAME").alias("interaction_name"),
            F.col("INTERACTION_DESC").alias("interaction_desc"),
            F.col("SCORE").alias("interaction_score"),
        )
        .dropDuplicates(["sas_model_version", "risk_model_segment", "hcc_code_1", "hcc_code_2"])
    )

    # Step 2: Load retained HCCs from claims / supplemental
    df_interaction_claim_draft = (
        spark.table(f"{catalog}.{schema_curation}.risk_member_hcc")
        .filter(
            (F.col("SUPPRESSION_IND") == "R") &
            (F.col("DX_SOURCE").isin(["claim", "supplemental"])) &
            (F.col("RISK_TYPE_ID") == "HCC") &
            (F.col("CYCLE_RUN") == source_load_year_month)
        )
    )
    # Step 2a: Filter suspected gaps to only include relevant records
    suspected_gaps_filtered = suspected_gaps_df.filter(
        (F.col("SUPPRESSION_IND") == "R") &
        (F.col("GAP_STATUS") == "Open Suspect")
    )
    # Step 2b: Keep only members present in BOTH dataframes
    member_intersection_df = (
        suspected_gaps_filtered.select(
            "MEMBER_BID", "RISK_YEAR", "SAS_MODEL_VERSION", "CYCLE_RUN"
        ).distinct()
        .join(
            df_interaction_claim_draft.select(
                "MEMBER_BID", "RISK_YEAR", "SAS_MODEL_VERSION", "CYCLE_RUN"
            ).distinct(),
            on=["MEMBER_BID", "RISK_YEAR", "SAS_MODEL_VERSION", "CYCLE_RUN"],
            how="inner"
        )
    )
    
    # Use semi-join to filter without adding duplicate columns
    suspected_gaps_valid = suspected_gaps_filtered.join(
        member_intersection_df,
        ["MEMBER_BID", "RISK_YEAR", "SAS_MODEL_VERSION", "CYCLE_RUN"],
        "left_semi"
    )

    claims_valid = df_interaction_claim_draft.join(
        member_intersection_df,
        ["MEMBER_BID", "RISK_YEAR", "SAS_MODEL_VERSION", "CYCLE_RUN"],
        "left_semi"
    )
    
    # Step 2c: Union validated datasets
    df_re_gs_union = suspected_gaps_valid.unionByName(claims_valid, allowMissingColumns=True)

    # Step 2d: Prepare retained HCC dataframe
    df_re_gs_union_retained_hcc_df = (
        df_re_gs_union
        .withColumn("hcc_code", F.col("RISK_TYPE_DETAIL_ID"))
        .select(
            F.col("MEMBER_BID").alias("member_bid"),
            F.col("HOME_PLAN_ID_CD").alias("home_plan_id_cd"),
            F.col("RISK_MODEL_YEAR").alias("risk_model_year"),
            F.col("RISK_MODEL_TYPE").alias("risk_model_type"),
            F.col("RISK_MODEL_VERSION").alias("risk_model_version"),
            F.col("RISK_YEAR").alias("risk_year"),
            F.col("SAS_MODEL_VERSION").alias("sas_model_version"),
            F.col("RISK_MODEL_SEGMENT").alias("risk_model_segment"),
            F.col("MEMBER_GENDER").alias("member_gender"),
            F.col("MEMBER_AGE").alias("member_age"),
            F.col("CYCLE_RUN").alias("cycle_run"),
            F.col("hcc_code"),
        )
        .na.drop()
        .dropDuplicates([
            "member_bid", "risk_year", "sas_model_version", "risk_model_segment", "cycle_run", "hcc_code"
        ])
    )

    # HCC Count Payment
    payment_df = create_hcc_count_payment_df(
        df=df_re_gs_union_retained_hcc_df,
        catalog=catalog,
        ma_reference=ma_reference,
        spark=spark,
        logger=logger,
        audit_metadata=audit_metadata
    )
    
    # Step 3: Generate HCC pairs
    logger.info("Generate HCC pairs started")
    left_hcc_df = df_re_gs_union_retained_hcc_df.alias("l")
    right_hcc_df = df_re_gs_union_retained_hcc_df.alias("r")

    hcc_pair_df = (
        left_hcc_df.join(
            right_hcc_df,
            (
                (F.col("l.member_bid") == F.col("r.member_bid")) &
                (F.col("l.risk_year") == F.col("r.risk_year")) &
                (F.col("l.sas_model_version") == F.col("r.sas_model_version")) &
                (F.col("l.risk_model_segment") == F.col("r.risk_model_segment")) &
                (F.col("l.cycle_run") == F.col("r.cycle_run")) &
                (F.col("l.hcc_code") < F.col("r.hcc_code"))
            ),
            "inner"
        )
        .select(
            F.col("l.member_bid"),
            F.col("l.home_plan_id_cd"),
            F.col("l.risk_model_year"),
            F.col("l.risk_model_type"),
            F.col("l.risk_model_version"),
            F.col("l.risk_year"),
            F.col("l.sas_model_version"),
            F.col("l.risk_model_segment"),
            F.col("l.member_gender"),
            F.col("l.member_age"),
            F.col("l.cycle_run"),
            F.col("l.hcc_code").alias("hcc_code_1"),
            F.col("r.hcc_code").alias("hcc_code_2"),
        )
    )
    logger.info("Generate HCC pairs completed")
    # Step 4: Match valid interactions
    logger.info("Match valid interactions started")
    matched_interactions_df = hcc_pair_df.join(
        df_ref_interaction_scores,
        ["sas_model_version", "risk_model_segment", "hcc_code_1", "hcc_code_2"],
        "inner"
    )
    logger.info("Match valid interactions completed")

    # Step 5: Dedupe to ONE row per valid interaction pair
    logger.info("Deduplicating to one row per interaction started")
    matched_interactions_df = matched_interactions_df.dropDuplicates([
        "member_bid", "risk_year", "sas_model_version", "cycle_run", "interaction_name"
    ])
    logger.info("Deduplicating to one row per interaction completed")

    # Step 6: Exclude existing DISEASE INTERACTION records
    logger.info("Checking for existing DISEASE INTERACTION records started")
    existing_interactions_df = (
        spark.table(f"{catalog}.{schema_curation}.risk_member_hcc")
        .filter(
            (F.col("RISK_TYPE_ID") == "DISEASE INTERACTION") &
            (F.col("CYCLE_RUN") == source_load_year_month)
        )
        .select(
            F.col("MEMBER_BID").alias("member_bid"),
            F.col("RISK_YEAR").alias("risk_year"),
            F.col("SAS_MODEL_VERSION").alias("sas_model_version"),
            F.col("CYCLE_RUN").alias("cycle_run"),
            F.col("RISK_TYPE_DETAIL_ID").alias("interaction_name")
        )
        .distinct()
    )

    # Anti-join to remove already existing interactions
    matched_interactions_df = matched_interactions_df.join(
        existing_interactions_df,
        ["member_bid", "risk_year", "sas_model_version", "cycle_run", "interaction_name"],
        "left_anti"
    )
    logger.info("Checking for existing DISEASE INTERACTION records completed")

    # Step 7: Apply adjustment factors
    logger.info("Apply adjustment factors started")
    adjustment_factor_df = (
        spark.table(f"{catalog}.{ma_reference}.adjustment_factors")
        .filter(~F.col("MODEL").startswith("cms_hcc_esrd"))
    )

    interaction_with_adjustment_df = (
        matched_interactions_df.join(
            adjustment_factor_df,
            (
                (F.lower(F.col("risk_model_version")) == F.lower(F.col("VERSION"))) &
                (F.lower(F.col("risk_model_type")) == F.lower(F.col("MODEL")))
            ),
            "inner"
        )
        .withColumn(
            "ADJ_COEFF_SCORE",
            F.round(
                (F.col("interaction_score") / F.col("NORMALIZATION_FACTOR")) *
                (1 - F.coalesce(F.col("CODING_PATTERN_ADJUSTMENT"), F.lit(0))),
                3
            )
        )
    )
    logger.info("Apply adjustment factors completed")
    # Step 8: Final dataframe
    logger.info("Final dataframe creation started")
    final_interaction_df = interaction_with_adjustment_df.select(
        F.col("member_bid").alias("MEMBER_BID"),
        F.col("home_plan_id_cd").alias("HOME_PLAN_ID_CD"),
        F.col("risk_model_year").alias("RISK_MODEL_YEAR"),
        F.col("risk_model_type").alias("RISK_MODEL_TYPE"),
        F.col("risk_model_version").alias("RISK_MODEL_VERSION"), 
        F.col("risk_model_segment").alias("RISK_MODEL_SEGMENT"),
        F.col("sas_model_version").alias("SAS_MODEL_VERSION"),
        F.col("member_gender").alias("MEMBER_GENDER"),
        F.col("member_age").alias("MEMBER_AGE"),
        F.lit("DISEASE INTERACTION").alias("RISK_TYPE_ID"),
        F.col("interaction_name").alias("RISK_TYPE_DETAIL_ID"),
        F.col("interaction_desc").alias("RISK_TYPE_DETAIL_DESC"),
        F.lit("R").alias("SUPPRESSION_IND"),
        F.lit(None).cast("smallint").alias("METHOD_ID"),
        F.col("ADJ_COEFF_SCORE").cast("double"),
        F.col("interaction_score").alias("COEFF_SCORE"),
        F.lit(None).cast("double").alias("METHOD_CONFIDENCE_FACTOR"),
        F.lit(None).cast("double").alias("COMBINED_CONFIDENCE_FACTOR"),
        F.lit(None).cast("string").alias("CHRONIC_HCC"),
        F.lit("suspected_gap").alias("DX_SOURCE"),
        F.lit("Open Suspect").alias("GAP_STATUS"),
        F.lit(None).cast("string").alias("CLAIM_TYPE"),
        F.lit(None).cast("long").alias("CLAIM_BID"),
        F.lit(None).cast("date").alias("CLAIM_DATE"),
        F.lit(None).cast("string").alias("DIAG_CD"),
        F.col("risk_year").alias("RISK_YEAR"),
        F.lit(None).cast("string").alias("HRA"),
        F.lit(None).cast("string").alias("HOME_HRA"),
        F.col("cycle_run").alias("CYCLE_RUN"),
        F.lit(None).cast("string").alias("ACTIVE_IND"),
        F.lit(audit_metadata['created_date']).cast("timestamp").alias("CREATED_DATE"),
        F.lit(audit_metadata['created_by']).alias("CREATED_BY"),
        F.lit(audit_metadata['updated_date']).cast("timestamp").alias("UPDATED_DATE"),
        F.lit(audit_metadata['updated_by']).alias("UPDATED_BY")
    )
    logger.info("Final dataframe creation completed")
    # Step 9: Insert into risk_member_hcc
    logger.info("Insert into risk_member_hcc started")
    final_df = final_interaction_df.unionByName(payment_df)

    final_df.write.insertInto(
        f"{catalog}.{schema_curation}.risk_member_hcc",
        overwrite=False
    )

    logger.info("Inserted interaction coefficient and payment count records successfully")
    return final_df

def create_hcc_count_payment_df(
    df: DataFrame,
    catalog: str,
    ma_reference: str,
    spark,
    logger,
    audit_metadata: dict
) -> DataFrame:
    """
    Creates HCC count payment DataFrame by aggregating HCC counts per member,
    generating payment codes, and joining with coefficient scores.

    Args:
        df (DataFrame): Input DataFrame containing member and HCC data with columns:
            - MEMBER_BID, HOME_PLAN_ID_CD, RISK_MODEL_YEAR, RISK_MODEL_TYPE,
            - RISK_MODEL_VERSION, RISK_MODEL_SEGMENT, SAS_MODEL_VERSION,
            - MEMBER_GENDER, MEMBER_AGE, RISK_YEAR, CYCLE_RUN, HCC_CODE
        catalog (str): Catalog name for coefficient_scores table
        ma_reference (str): Schema name for coefficient_scores table
        spark: SparkSession instance

    Returns:
        DataFrame: Payment DataFrame with standardized columns for union, including:
            - Member identifiers and demographics
            - RISK_TYPE_ID = "HCC COUNT PAYMENT"
            - RISK_TYPE_DETAIL_ID = payment code (e.g., "CNA_D5", "CNA_D10P")
            - ADJ_COEFF_SCORE and COEFF_SCORE from coefficient table
            - Audit columns (CREATED_DATE, CREATED_BY, etc.)

    Raises:
        Exception: If aggregation or join operations fail
    """
    try:
        logger.info("Starting HCC count payment DataFrame creation")
        # account_name = spark.sql("SELECT current_user()").collect()[0][0]
        
        # Step 1: Aggregate HCC counts by member
        result_df = df.groupBy(
            "MEMBER_BID",
            "HOME_PLAN_ID_CD",
            "RISK_MODEL_YEAR",
            "RISK_MODEL_TYPE",
            "RISK_MODEL_VERSION",
            "RISK_MODEL_SEGMENT",
            "SAS_MODEL_VERSION",
            "MEMBER_GENDER",
            "MEMBER_AGE",
            "RISK_YEAR",
            "CYCLE_RUN"
        ).agg(
            F.countDistinct("HCC_CODE").alias("HCC_COUNT")
        ).withColumn(
            "HCC_COUNT_PAYMENT",
            F.when(
                F.col("HCC_COUNT") >= 10,
                F.concat(F.col("RISK_MODEL_SEGMENT"), F.lit("_D10P"))
            ).otherwise(
                F.concat(F.col("RISK_MODEL_SEGMENT"), F.lit("_D"), F.col("HCC_COUNT"))
            )
        )
        
        logger.info(f"Aggregated HCC counts for {result_df.count()} members")
        
        # Step 2: Load coefficient scores table
        coefficient_scores = spark.table(f"{catalog}.{ma_reference}.coefficient_scores")
        logger.info("Loaded coefficient_scores table")
        
        # Step 3: Join with coefficient scores to get payment scores
        payment_df = result_df.alias("result").join(
            F.broadcast(coefficient_scores.alias("coeff")),
            (
                (F.lower(F.col("result.RISK_MODEL_VERSION")) == F.lower(F.col("coeff.VERSION"))) &
                (F.lower(F.col("result.RISK_MODEL_TYPE")) == F.lower(F.col("coeff.MODEL"))) &
                (F.lower(F.col("result.HCC_COUNT_PAYMENT")) == F.lower(F.col("coeff.NAME")))
            ),
            how="left"
        ).select(
            F.col("result.MEMBER_BID").alias("MEMBER_BID"),
            F.col("result.HOME_PLAN_ID_CD").alias("HOME_PLAN_ID_CD"),
            F.col("result.RISK_MODEL_YEAR").alias("RISK_MODEL_YEAR"),
            F.col("result.RISK_MODEL_TYPE").alias("RISK_MODEL_TYPE"),
            F.col("result.RISK_MODEL_VERSION").alias("RISK_MODEL_VERSION"),
            F.col("result.RISK_MODEL_SEGMENT").alias("RISK_MODEL_SEGMENT"),
            F.col("result.SAS_MODEL_VERSION").alias("SAS_MODEL_VERSION"),
            F.col("result.MEMBER_GENDER").alias("MEMBER_GENDER"),
            F.col("result.MEMBER_AGE").alias("MEMBER_AGE"),
            F.lit("HCC COUNT PAYMENT").alias("RISK_TYPE_ID"),
            F.col("result.HCC_COUNT_PAYMENT").alias("RISK_TYPE_DETAIL_ID"),
            F.coalesce(
                F.col("coeff.DESCRIPTION"),
                F.lit("HCC Count Payment")
            ).alias("RISK_TYPE_DETAIL_DESC"),
            F.lit("R").alias("SUPPRESSION_IND"),
            F.lit(None).cast("smallint").alias("METHOD_ID"),
            F.lit(None).cast("double").alias("ADJ_COEFF_SCORE"),
            F.coalesce(F.col("coeff.SCORE"), F.lit(0.0)).cast("double").alias("COEFF_SCORE"),
            F.lit(None).cast("double").alias("METHOD_CONFIDENCE_FACTOR"),
            F.lit(None).cast("double").alias("COMBINED_CONFIDENCE_FACTOR"),
            F.lit(None).cast("string").alias("CHRONIC_HCC"),
            F.lit("suspected_gap").alias("DX_SOURCE"),
            F.lit("Open Suspect").alias("GAP_STATUS"),
            F.lit(None).cast("string").alias("CLAIM_TYPE"),
            F.lit(None).cast("long").alias("CLAIM_BID"),
            F.lit(None).cast("date").alias("CLAIM_DATE"),
            F.lit(None).cast("string").alias("DIAG_CD"),
            F.col("result.RISK_YEAR").alias("RISK_YEAR"),
            F.lit(None).cast("string").alias("HRA"),
            F.lit(None).cast("string").alias("HOME_HRA"),
            F.col("result.CYCLE_RUN").alias("CYCLE_RUN"),
            F.lit(None).cast("string").alias("ACTIVE_IND"),
            F.lit(audit_metadata['created_date']).cast("timestamp").alias("CREATED_DATE"),
            F.lit(audit_metadata['created_by']).alias("CREATED_BY"),
            F.lit(audit_metadata['updated_date']).cast("timestamp").alias("UPDATED_DATE"),
            F.lit(audit_metadata['updated_by']).alias("UPDATED_BY"),
        )
        return payment_df
        
    except Exception as e:
        logger.error(f"Error in create_hcc_count_payment_df: {str(e)}")
        raise Exception(f"Failed to create HCC count payment DataFrame: {str(e)}")
 
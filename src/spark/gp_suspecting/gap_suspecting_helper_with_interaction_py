def get_time_period(spark, catalog, ma_reference, risk_year,no_of_year):
    """Get time periods for specified number of years."""
    risk_year = int(risk_year)
    no_of_year = int(no_of_year)
    start_year = risk_year - no_of_year + 1
    begin_date = f"{start_year}-01-01"
    end_date = f"{risk_year}-12-31"
    
    query = f"""
        SELECT TIME_PERIOD 
        FROM {catalog}.{ma_reference}.time_periods 
        WHERE BEGIN_DATE >= '{begin_date}' 
          AND END_DATE <= '{end_date}'
          AND TIME_PERIOD_TYPE_CD='C'
    """
    time_period_list = [str(row['TIME_PERIOD']) for row in spark.sql(query).collect()]
    return ','.join(time_period_list)

